  <!-- Chatbot engine: lazy-loaded on idle (or first toggle click) to keep it off the critical path / out of mobile TBT -->
  <script>
    (function () {
      var loaded = false;
      function loadAIEngine() {
        if (loaded) return;
        loaded = true;
        var s = document.createElement('script');
        s.src = '/js/ai-engine.js?v=2.5';
        document.body.appendChild(s);
      }
      // Stub: if the chat is opened before the engine loads, flag it and load now.
      window.toggleAIChat = function () { window.__aiOpenPending = true; loadAIEngine(); };
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadAIEngine, { timeout: 3000 });
      } else {
        setTimeout(loadAIEngine, 1800);
      }
    })();
  </script>
  <script src="/js/main.js?v=3.0" defer></script>

<!-- High Speed Navigation Engine & Silent GPS Refresher -->
  <script>
  (function() {
    function sendGpsCoords(lat, lng, accuracy) {
      try {
        var payload = JSON.stringify({ lat: lat, lng: lng, accuracy: accuracy || 0 });
        if (navigator.sendBeacon) {
          var blob = new Blob([payload], { type: 'application/json' });
          navigator.sendBeacon('/api/track/geo', blob);
        } else {
          fetch('/api/track/geo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: payload,
            keepalive: true
          }).catch(function() {});
        }
      } catch(e) {}
    }

    function handleGeoSuccess(pos) {
      if (pos && pos.coords) {
        localStorage.setItem('alexcloud_geo_granted', '1');
        sendGpsCoords(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy);
      }
    }

    function analyticsAllowed() {
      try {
        var raw = document.cookie.split(';').map(function(v) { return v.trim(); }).find(function(v) { return v.indexOf('ac_consent=') === 0; });
        var value = raw ? JSON.parse(decodeURIComponent(raw.slice('ac_consent='.length))) : null;
        return Boolean(value && value.version === '2026-09-22' && value.analytics);
      } catch (e) { return false; }
    }

    function refreshGrantedLocation() {
      if (!analyticsAllowed() || !('permissions' in navigator) || !navigator.permissions.query) return;
      navigator.permissions.query({ name: 'geolocation' }).then(function(res) {
        if (res.state === 'granted') {
          navigator.geolocation.getCurrentPosition(handleGeoSuccess, function() {}, {
            enableHighAccuracy: true,
            timeout: 8000,
            maximumAge: 60000
          });
        }
      }).catch(function() {});
    }
    refreshGrantedLocation();
    window.addEventListener('alexcloud:consent', refreshGrantedLocation);
  })();
  </script>

