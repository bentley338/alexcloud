    </div>

    <div class="ax-game-grid" id="gamesDisplay">
      <% 
        function getBadgeStyle(tag) {
          const t = (tag || '').toUpperCase();
          if (t.includes('POPULAR')) return 'background: linear-gradient(135deg, #fbbf24, #d97706); color: #000; box-shadow: 0 4px 14px rgba(251,191,36,0.35);';
          if (t.includes('HOT')) return 'background: linear-gradient(135deg, #ef4444, #b91c1c); color: #fff; box-shadow: 0 4px 14px rgba(239,68,68,0.35);';
          if (t.includes('NEW')) return 'background: linear-gradient(135deg, #10b981, #059669); color: #fff; box-shadow: 0 4px 14px rgba(16,185,129,0.35);';
          if (t.includes('BESTSELLER')) return 'background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: #fff; box-shadow: 0 4px 14px rgba(139,92,246,0.35);';
          if (t.includes('TOP RATED')) return 'background: linear-gradient(135deg, #f59e0b, #d97706); color: #000; box-shadow: 0 4px 14px rgba(245,158,11,0.35);';
          if (t.includes('CLASSIC')) return 'background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: #fff; box-shadow: 0 4px 14px rgba(59,130,246,0.35);';
          if (t.includes('COMING SOON')) return 'background: linear-gradient(135deg, #64748b, #334155); color: #fff; box-shadow: 0 4px 14px rgba(100,116,139,0.35);';
          return 'background: rgba(0,0,0,0.8); border: 1px solid rgba(255,255,255,0.25); color: #fbbf24;';
        }
      %>

      <% games.slice(0, 8).forEach((game, i) => { %>
      <div class="ax-card">
        <div class="ax-card-poster">
          <img src="<%= game.image %>" alt="<%= game.name %>" loading="lazy" decoding="async">
          <% if (game.tag) { %>
            <div class="ax-card-badge" style="<%= getBadgeStyle(game.tag) %>">
              <% if (game.tag.toUpperCase().includes('POPULAR')) { %><i class="fas fa-fire"></i><% } %>
              <% if (game.tag.toUpperCase().includes('HOT')) { %><i class="fas fa-bolt"></i><% } %>
              <% if (game.tag.toUpperCase().includes('TOP RATED')) { %><i class="fas fa-star"></i><% } %>
              <% if (game.tag.toUpperCase().includes('BESTSELLER')) { %><i class="fas fa-crown"></i><% } %>
              <%= game.tag %>
            </div>
          <% } %>
        </div>
        <div class="ax-card-body">
          <div>
            <div class="ax-card-title"><%= game.name %></div>
            <div class="ax-card-genre"><i class="fas fa-tag"></i> <%= game.genre %></div>
          </div>
          <div class="ax-card-footer">
            <div class="ax-card-rating"><i class="fas fa-star"></i> <%= game.rating %></div>
            <span class="ax-card-status"><i class="fas fa-cloud"></i> Ready Cloud</span>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    
    <div style="text-align: center;">
      <a href="/games?ref_=home_explore_games" class="ax-btn-hero-secondary" style="padding: 0.8rem 2rem; border-radius: 12px; font-weight: 800;">
        <i class="fas fa-th-large"></i> Lihat Semua <%= typeof totalGamesCount !== 'undefined' ? totalGamesCount : '' %> Game
      </a>
    </div>
  </div>
</section>

