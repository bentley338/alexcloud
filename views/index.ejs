<%- include('partials/header') %>

<style>
/* ==========================================================================
   ALEXCLOUD ULTRA TIER-1 GLOBAL GAMING DESIGN SYSTEM
   Fluid Responsive Scaling, Mobile-First Performance & High-Tech Obsidian Dark
   ========================================================================== */

:root {
  --ax-bg-void: #06070c;
  --ax-bg-card: rgba(15, 18, 28, 0.85);
  --ax-bg-card-hover: rgba(22, 27, 42, 0.95);
  --ax-border: rgba(255, 255, 255, 0.08);
  --ax-border-gold: rgba(251, 191, 36, 0.35);
  --ax-border-cyan: rgba(0, 242, 254, 0.35);
  --ax-gold: #fbbf24;
  --ax-gold-glow: rgba(251, 191, 36, 0.25);
  --ax-cyan: #00f2fe;
  --ax-cyan-glow: rgba(0, 242, 254, 0.25);
  --ax-green: #10b981;
  --ax-text-main: #f8fafc;
  --ax-text-muted: #94a3b8;
  --ax-radius-lg: 20px;
  --ax-radius-md: 14px;
}

body {
  background-color: var(--ax-bg-void) !important;
  color: var(--ax-text-main) !important;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden !important;
}

/* Atmospheric Lighting Gradients */
.ax-ambient-mesh {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.ax-mesh-glow-1 {
  position: absolute;
  top: -60px;
  left: 10%;
  width: 550px;
  height: 550px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(251, 191, 36, 0.12) 0%, rgba(217, 119, 6, 0.02) 60%, transparent 80%);
  filter: blur(80px);
}

.ax-mesh-glow-2 {
  position: absolute;
  top: 100px;
  right: 5%;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 242, 254, 0.1) 0%, rgba(59, 130, 246, 0.02) 60%, transparent 80%);
  filter: blur(80px);
}

/* ==========================================================================
   HERO SECTION
   ========================================================================== */
.hero {
  position: relative;
  width: 100%;
  padding-top: 8.5rem !important;
  padding-bottom: 3.5rem !important;
  background: transparent !important;
  overflow: hidden;
  box-sizing: border-box;
}

.hero-container {
  max-width: 1240px !important;
  width: 100% !important;
  margin: 0 auto !important;
  padding: 0 1.5rem !important;
  display: grid !important;
  grid-template-columns: 1.15fr 0.85fr !important;
  gap: 2.5rem !important;
  align-items: center !important;
  position: relative !important;
  z-index: 2 !important;
  box-sizing: border-box !important;
}

/* ==========================================================================
   PROMO SPESIAL FLOATING TOP BANNER (GRID-COLUMN SPAN ALL)
   ========================================================================== */
.ax-promo-banner-wrap {
  grid-column: 1 / -1 !important;
  width: 100% !important;
  margin-top: 0.5rem !important;
  margin-bottom: 1rem !important;
  box-sizing: border-box !important;
  position: relative;
  z-index: 10;
}

.ax-promo-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.15) 0%, rgba(217, 119, 6, 0.08) 50%, rgba(15, 18, 28, 0.95) 100%);
  border: 1px solid rgba(251, 191, 36, 0.35);
  border-radius: 14px;
  padding: 0.75rem 1.25rem;
  box-shadow: 0 4px 20px rgba(251, 191, 36, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(12px);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.ax-promo-banner:hover {
  border-color: rgba(251, 191, 36, 0.6);
  box-shadow: 0 6px 25px rgba(251, 191, 36, 0.25);
}

.ax-promo-banner::before {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 4px; height: 100%;
  background: linear-gradient(180deg, #fbbf24, #d97706);
}

.ax-promo-left {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  flex: 1;
}

.ax-promo-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
  color: #000;
  font-weight: 900;
  font-size: 0.72rem;
  padding: 0.25rem 0.65rem;
  border-radius: 8px;
  letter-spacing: 0.5px;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(251, 191, 36, 0.4);
}

.ax-promo-text {
  font-size: 0.88rem;
  color: #f8fafc;
  line-height: 1.45;
  font-weight: 500;
}

.ax-promo-text strong {
  color: #fbbf24;
  font-weight: 800;
}

.ax-promo-code {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.15);
  padding: 0.1rem 0.45rem;
  border-radius: 6px;
  border: 1px dashed rgba(251, 191, 36, 0.5);
  cursor: pointer;
  letter-spacing: 0.5px;
  font-weight: 800;
  transition: all 0.2s;
}

.ax-promo-code:hover {
  background: rgba(251, 191, 36, 0.3);
  border-color: #fbbf24;
}

.ax-promo-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.ax-btn-copy-promo {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
  color: #000 !important;
  font-weight: 800;
  font-size: 0.78rem;
  padding: 0.45rem 0.95rem;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s ease;
  box-shadow: 0 2px 10px rgba(251, 191, 36, 0.35);
}

.ax-btn-copy-promo:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 15px rgba(251, 191, 36, 0.5);
}

/* Hero Badge */
.ax-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.45rem 1.15rem;
  border-radius: 100px;
  background: rgba(251, 191, 36, 0.08);
  border: 1px solid rgba(251, 191, 36, 0.35);
  color: #fbbf24;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  margin-bottom: 1.35rem;
  backdrop-filter: blur(12px);
  box-shadow: 0 0 25px rgba(251, 191, 36, 0.15);
  transition: all 0.3s ease;
}

.ax-hero-badge:hover {
  transform: translateY(-2px);
  border-color: #fbbf24;
  box-shadow: 0 0 35px rgba(251, 191, 36, 0.3);
}

.ax-live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 8px #10b981;
  animation: axPulse 1.8s infinite;
  flex-shrink: 0;
}

@keyframes axPulse {
  0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { transform: scale(1.1); box-shadow: 0 0 0 7px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

/* Hero Typography */
.ax-hero-title {
  font-size: 3.2rem;
  font-weight: 900;
  line-height: 1.14;
  letter-spacing: -0.035em;
  color: #ffffff;
  margin-bottom: 1.15rem;
}

.ax-hero-gradient {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #00f2fe 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
  filter: drop-shadow(0 0 25px rgba(251, 191, 36, 0.3));
}

.ax-hero-sub {
  font-size: 1.05rem;
  line-height: 1.6;
  color: #94a3b8;
  max-width: 560px;
  margin-bottom: 1.75rem;
}

/* Hero CTA Buttons */
.ax-hero-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}

.ax-btn-hero-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.65rem;
  padding: 0.9rem 1.85rem;
  border-radius: 12px;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: #06070c !important;
  font-weight: 800;
  font-size: 0.95rem;
  text-decoration: none;
  box-shadow: 0 8px 30px rgba(251, 191, 36, 0.35);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}

.ax-btn-hero-primary::after {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  transform: skewX(-20deg);
  animation: axShimmer 3.5s infinite;
}

@keyframes axShimmer {
  0% { left: -100%; }
  25%, 100% { left: 200%; }
}

.ax-btn-hero-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 35px rgba(251, 191, 36, 0.5);
  color: #000 !important;
}

.ax-btn-hero-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.65rem;
  padding: 0.9rem 1.65rem;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #ffffff !important;
  font-weight: 700;
  font-size: 0.95rem;
  text-decoration: none;
  backdrop-filter: blur(12px);
  transition: all 0.3s ease;
}

.ax-btn-hero-secondary:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.3);
  transform: translateY(-2px);
}

.ax-trust-row {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex-wrap: wrap;
  color: #64748b;
  font-size: 0.82rem;
  font-weight: 600;
  margin-bottom: 1.75rem;
}

.ax-trust-row span {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.ax-trust-row i {
  color: #10b981;
  font-size: 0.85rem;
}

/* ==========================================================================
   MEMBER CONTROL BENTO WIDGET
   ========================================================================== */
.ax-member-bento {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 0.85rem;
  background: rgba(15, 18, 28, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--ax-radius-md);
  padding: 1rem;
  backdrop-filter: blur(16px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  margin-bottom: 1.75rem;
}

.ax-wallet-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  padding: 0.75rem 0.9rem;
}

.ax-wallet-info {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.ax-wallet-icon-box {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.2), rgba(217, 119, 6, 0.1));
  border: 1px solid rgba(251, 191, 36, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ax-wallet-lbl {
  font-size: 0.7rem;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-weight: 700;
}

.ax-wallet-val {
  font-size: 1.1rem;
  font-weight: 800;
  color: #fbbf24;
  letter-spacing: -0.01em;
}

.ax-topup-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.45rem 0.85rem;
  border-radius: 8px;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #06070c !important;
  font-weight: 800;
  font-size: 0.75rem;
  text-decoration: none;
  box-shadow: 0 4px 12px rgba(251, 191, 36, 0.25);
  transition: all 0.2s ease;
}

.ax-topup-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(251, 191, 36, 0.4);
}

.ax-streak-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  padding: 0.75rem 0.9rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ax-streak-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.45rem;
}

.ax-streak-title {
  font-size: 0.75rem;
  font-weight: 800;
  color: #f8fafc;
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.ax-streak-claim-btn {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #fff;
  border: none;
  padding: 0.25rem 0.65rem;
  border-radius: 6px;
  font-size: 0.7rem;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
  transition: all 0.2s;
}

.ax-streak-days {
  display: flex;
  gap: 0.3rem;
  justify-content: space-between;
}

.ax-day-pill {
  flex: 1;
  text-align: center;
  padding: 0.2rem 0;
  border-radius: 6px;
  font-size: 0.62rem;
  font-weight: 700;
  border: 1px solid transparent;
}

.ax-day-pill.passed {
  background: rgba(16, 185, 129, 0.15);
  border-color: rgba(16, 185, 129, 0.35);
  color: #10b981;
}

.ax-day-pill.today {
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.3), rgba(217, 119, 6, 0.2));
  border-color: #fbbf24;
  color: #fbbf24;
  box-shadow: 0 0 10px rgba(251, 191, 36, 0.3);
}

.ax-day-pill.future {
  background: rgba(255, 255, 255, 0.03);
  border-color: rgba(255, 255, 255, 0.06);
  color: #64748b;
}

/* Hero Stats Counter */
.ax-hero-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.85rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 1.5rem;
}

.ax-stat-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  padding: 0.75rem 0.5rem;
  text-align: center;
}

.ax-stat-val {
  font-size: 1.45rem;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: -0.02em;
}

.ax-stat-lbl {
  font-size: 0.72rem;
  color: #94a3b8;
  font-weight: 600;
}

/* ==========================================================================
   RIGHT HERO - LIVE RIG SHOWCASE
   ========================================================================== */
.ax-rig-showcase {
  background: rgba(15, 18, 28, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--ax-radius-lg);
  padding: 1.35rem;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20px);
  display: flex;
  flex-direction: column;
  gap: 1.15rem;
  position: relative;
  overflow: hidden;
}

.ax-rig-showcase::before {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 150px; height: 150px;
  background: radial-gradient(circle, rgba(0, 242, 254, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.ax-rig-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 0.75rem;
}

.ax-rig-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 800;
  font-size: 0.88rem;
  color: #f8fafc;
  letter-spacing: 0.5px;
}

.ax-rig-beacon {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.35);
  color: #10b981;
  font-size: 0.7rem;
  font-weight: 800;
  padding: 0.25rem 0.65rem;
  border-radius: 100px;
}

.ax-dual-games {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.85rem;
}

.ax-game-preview-card {
  position: relative;
  height: 145px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
}

.ax-game-preview-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.ax-game-preview-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(6,7,12,0.92) 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0.65rem;
}

.ax-game-preview-tag {
  font-size: 0.65rem;
  font-weight: 800;
  color: #00f2fe;
  text-transform: uppercase;
  margin-bottom: 0.15rem;
}

.ax-game-preview-name {
  font-size: 0.82rem;
  font-weight: 800;
  color: #ffffff;
}

.ax-rig-specs-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  padding: 0.65rem;
  font-size: 0.72rem;
  color: #94a3b8;
}

.ax-rig-specs-bar span {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.ax-rig-specs-bar strong {
  color: #ffffff;
}

/* ==========================================================================
   INFINITE HARDWARE & CLOUD TECH TICKER
   ========================================================================== */
.ax-ticker-wrap {
  width: 100%;
  background: rgba(10, 13, 22, 0.95);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding: 0.85rem 0;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.5);
}

.ax-ticker-track {
  display: flex;
  gap: 2.5rem;
  width: max-content;
  animation: axTickerScroll 35s linear infinite;
}

.ax-ticker-track:hover {
  animation-play-state: paused;
}

@keyframes axTickerScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.ax-ticker-item {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.82rem;
  font-weight: 700;
  color: #cbd5e1;
  white-space: nowrap;
}

.ax-ticker-item i {
  color: #fbbf24;
}

/* ==========================================================================
   KENAPA ALEXCLOUD (FEATURES) - MATCHING CARA MAIN BACKGROUND & CONTRAST
   ========================================================================== */
.features-section {
  padding: 3.5rem 0;
  background: var(--ax-bg-void) !important;
  position: relative;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}

.feature-card {
  background: #131418 !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  border-radius: var(--ax-radius-lg) !important;
  padding: 2rem 1.6rem !important;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease !important;
  position: relative !important;
  overflow: hidden !important;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45) !important;
}

.feature-card:hover {
  border-color: rgba(251, 191, 36, 0.35) !important;
  transform: translateY(-6px) !important;
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(251, 191, 36, 0.2) !important;
}

.feature-icon {
  width: 58px;
  height: 58px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  margin-bottom: 1.25rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
}

.feature-title {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 0.5rem;
}

.feature-desc {
  color: #94a3b8;
  font-size: 0.88rem;
  line-height: 1.6;
}

/* ==========================================================================
   CARA MAIN (HOW IT WORKS)
   ========================================================================== */
.how-section {
  padding: 3.5rem 0;
  background: var(--ax-bg-void) !important;
  position: relative;
}

/* ==========================================================================
   STEAM-STYLE GAME CARDS & 2-COL MOBILE GRID
   ========================================================================== */
.ax-game-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  margin-bottom: 2.5rem;
}

.ax-card {
  background: rgba(15, 18, 28, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
}

.ax-card:hover {
  transform: translateY(-8px);
  border-color: rgba(251, 191, 36, 0.4);
