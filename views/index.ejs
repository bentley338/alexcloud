/* ==========================================================================
   ALEXCLOUD HOMEPAGE — PROFESSIONAL RESPONSIVE FINISH
   One final cascade layer to unify the older component rules above.
   ========================================================================== */
:root {
  --home-bg: #07090d;
  --home-surface: #101319;
  --home-surface-raised: #151922;
  --home-border: rgba(255, 255, 255, 0.1);
  --home-border-strong: rgba(255, 255, 255, 0.16);
  --home-copy: #f8fafc;
  --home-muted: #a4aec0;
  --home-accent: #fbbf24;
  --home-accent-strong: #f59e0b;
  --home-success: #34d399;
  --home-cyan: #67e8f9;
  --home-radius: 18px;
  --home-ease: cubic-bezier(0.22, 1, 0.36, 1);
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 88px;
}

body {
  background:
    radial-gradient(circle at 76% 11%, rgba(14, 165, 233, 0.07), transparent 28rem),
    radial-gradient(circle at 18% 9%, rgba(245, 158, 11, 0.08), transparent 26rem),
    var(--home-bg) !important;
  color: var(--home-copy) !important;
  text-rendering: optimizeLegibility;
}

/* Single-row, product-focused desktop navigation. Secondary pages remain in
   the mobile drawer and footer, keeping the primary navigation easy to scan. */
.navbar {
  min-height: 72px;
  padding: 0 !important;
  background: rgba(7, 9, 13, 0.88) !important;
  border-bottom-color: rgba(255, 255, 255, 0.08) !important;
  backdrop-filter: blur(18px) saturate(130%) !important;
  -webkit-backdrop-filter: blur(18px) saturate(130%) !important;
}

.nav-container {
  width: min(100% - 40px, 1240px) !important;
  min-height: 72px;
  padding: 0 !important;
  gap: 1.1rem !important;
  flex-wrap: nowrap !important;
}

.nav-logo { min-height: 48px; }
.logo-text { letter-spacing: 0.08em !important; }
.nav-links {
  flex-wrap: nowrap !important;
  gap: 0.15rem !important;
  min-width: 0;
}
.nav-link {
  min-height: 44px;
  padding: 0.7rem 0.72rem !important;
  display: inline-flex;
  align-items: center;
  font-size: 0.86rem !important;
  white-space: nowrap;
}
.nav-link:hover {
  background: rgba(255, 255, 255, 0.055) !important;
  color: #fff !important;
}
.nav-search-wrap { max-width: 190px !important; }
.nav-search-input { min-height: 42px; }
.nav-user-btn, .btn-nav-cta { min-height: 44px; white-space: nowrap; }

@media (min-width: 901px) {
  .nav-links > a[href^="/testimonials"],
  .nav-links > a[href^="/community"],
  .nav-links > a[href^="/network-test"],
  .nav-links > a[href^="/faq"] {
    display: none !important;
  }
}

