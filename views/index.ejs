<!-- IMAGE MODAL VIEWER -->
<div id="imageModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.9); z-index:999999; align-items:center; justify-content:center; padding:1rem;" onclick="this.style.display='none'">
  <img id="modalImg" src="" alt="Bukti testimoni pelanggan" style="max-width:90vw; max-height:85vh; border-radius:12px; border:2px solid #fbbf24; box-shadow:0 0 40px rgba(0,0,0,0.9);">
</div>

<script>
// Home Custom Royal Days Slider Calculator
function updateHomeCustomDays(days) {
  var d = parseInt(days, 10);
  var valText = document.getElementById('homeSliderValText');
  var nameEl = document.getElementById('homeCustomDaysName');
  var priceEl = document.getElementById('homeCustomDaysPrice');
  var periodEl = document.getElementById('homeCustomDaysPeriod');
  var btnEl = document.getElementById('homeCustomOrderBtn');

  if (valText) valText.innerText = d + ' Hari';
  if (nameEl) nameEl.innerText = 'Sewa Harian (' + d + ' Hari)';
  var total = d * 7000;
  if (priceEl) priceEl.innerText = 'Rp ' + total.toLocaleString('id-ID');
  if (periodEl) periodEl.innerText = 'Akses fleksibel ' + d + ' hari (Rp 7.000/hari)';
  
  if (btnEl) {
    <% if (typeof user !== 'undefined' && user && user.isRoyal) { %>
      btnEl.href = '/order/custom_royal?days=' + d;
    <% } else { %>
      btnEl.href = '/order/royal_access';
    <% } %>
  }
}

// Interactive Testimonials Carousel Controller with Precise Positioning & Touch Support
var currentTestiIndex = 0;
var totalTestis = <%= testimonials.length %>;

function updateTestiSlider() {
  var track = document.getElementById('testiTrack');
  if (!track) return;
  var cards = track.querySelectorAll('.ax-testi-card');
  if (!cards || cards.length === 0) return;
  
  if (currentTestiIndex >= totalTestis) currentTestiIndex = 0;
  if (currentTestiIndex < 0) currentTestiIndex = totalTestis - 1;

  var isMobile = window.innerWidth <= 900;
  if (isMobile) {
    track.style.transform = 'translateX(-' + (currentTestiIndex * 100) + '%)';
  } else {
    var maxIndex = Math.max(0, totalTestis - 3);
    var targetIndex = Math.min(currentTestiIndex, maxIndex);
    if (cards[targetIndex]) {
      var offset = cards[targetIndex].offsetLeft;
      track.style.transform = 'translateX(-' + offset + 'px)';
    }
  }
  
  var dots = document.querySelectorAll('.ax-testi-dot');
  dots.forEach(function(dot, idx) {
    if (idx === currentTestiIndex) dot.classList.add('active');
    else dot.classList.remove('active');
  });
}

function nextTesti() {
  var isMobile = window.innerWidth <= 900;
  var maxIndex = isMobile ? (totalTestis - 1) : Math.max(0, totalTestis - 3);
  if (currentTestiIndex < maxIndex) {
    currentTestiIndex++;
  } else {
    currentTestiIndex = 0;
  }
  updateTestiSlider();
}

function prevTesti() {
  var isMobile = window.innerWidth <= 900;
  var maxIndex = isMobile ? (totalTestis - 1) : Math.max(0, totalTestis - 3);
  if (currentTestiIndex > 0) {
    currentTestiIndex--;
  } else {
    currentTestiIndex = maxIndex;
  }
  updateTestiSlider();
}

function goToTesti(index) {
  currentTestiIndex = index;
  updateTestiSlider();
}

// Auto Slide every 6 seconds
var testiInterval = setInterval(function() {
  nextTesti();
}, 6000);

// Touch Swipe Gesture Support for Mobile
(function() {
  var track = document.getElementById('testiTrack');
  if (!track) return;
  var startX = 0;
  var startY = 0;
  var distX = 0;
  var distY = 0;

  track.addEventListener('touchstart', function(e) {
    var touch = e.touches[0];
    startX = touch.clientX;
    startY = touch.clientY;
    distX = 0;
    distY = 0;
    clearInterval(testiInterval);
  }, { passive: true });

  track.addEventListener('touchmove', function(e) {
    if (!startX || !startY) return;
    var touch = e.touches[0];
    distX = touch.clientX - startX;
    distY = touch.clientY - startY;
  }, { passive: true });

  track.addEventListener('touchend', function() {
    if (Math.abs(distX) > 40 && Math.abs(distX) > Math.abs(distY)) {
      if (distX < 0) nextTesti();
      else prevTesti();
    }
    startX = 0;
    startY = 0;
    testiInterval = setInterval(function() { nextTesti(); }, 6000);
  }, { passive: true });
})();

// Image Modal Opener
function openImageModal(src) {
  var modal = document.getElementById('imageModal');
  var img = document.getElementById('modalImg');
  if (modal && img) {
    img.src = src;
    modal.style.display = 'flex';
  }
}

// Claim Daily Login Streak
function claimDailyLogin() {
  var btn = document.getElementById('btnDailyLogin');
  if (btn) btn.disabled = true;
  
  fetch('/api/claim-daily-login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    if (data.success) {
      alert('🎉 ' + data.message);
      window.location.reload();
    } else {
      alert('⚠️ ' + (data.message || 'Gagal klaim'));
      if (btn) btn.disabled = false;
    }
  })
  .catch(function(err) {
    alert('Terjadi kesalahan koneksi.');
    if (btn) btn.disabled = false;
  });
}
</script>

