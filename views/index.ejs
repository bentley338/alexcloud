<!-- HERO SECTION -->
<section class="hero" id="main-content" aria-label="Hero utama">
  <div class="ax-ambient-mesh">
    <div class="ax-mesh-glow-1"></div>
    <div class="ax-mesh-glow-2"></div>
  </div>

  <div class="hero-container">
    <!-- SINGLE UNIFIED TOP PROMO / ANNOUNCEMENT BANNER -->
    <div class="ax-promo-banner-wrap" id="topPromoBanner">
      <div class="ax-promo-banner">
        <div class="ax-promo-left">
          <div class="ax-promo-badge">
            <i class="fas fa-gift"></i> PROMO SPESIAL
          </div>
          <div class="ax-promo-text">
            <% if (typeof announcement !== 'undefined' && announcement && announcement.text) { %>
              <%= announcement.text %>
              <% if (announcement.link && announcement.linkText) { %>
                <a href="<%= announcement.link %>" style="color:#fbbf24; font-weight:800; text-decoration:underline; margin-left:0.5rem;"><%= announcement.linkText %> →</a>
              <% } %>
            <% } else { %>
              Hemat 10% untuk transaksi di atas Rp100.000 dengan kode <span class="ax-promo-code" onclick="copyPromoCode('ALEX10')" title="Klik untuk salin">ALEX10</span>.
            <% } %>
          </div>
        </div>
        <div class="ax-promo-actions">
          <button type="button" class="ax-btn-copy-promo" onclick="copyPromoCode('ALEX10')">
            <i class="fas fa-copy"></i> Salin Kode: ALEX10
          </button>
        </div>
      </div>
    </div>

    <!-- Left Hero Column -->
    <div class="hero-content">
      <div class="ax-hero-badge">
        <img src="/images/logo-icon.png" alt="AlexCloud" width="18" height="18" style="object-fit:contain; filter:drop-shadow(0 0 6px rgba(251,191,36,0.6));">
        <span class="ax-live-dot"></span>
        <span>Cloud gaming untuk perangkat yang kamu punya</span>
      </div>

      <h1 class="ax-hero-title">
        Main game PC dari<br>
        <span class="ax-hero-gradient">perangkat yang kamu punya.</span>
      </h1>

      <p class="ax-hero-sub">
        Game berjalan di cloud. Pilih game, masuk ke akunmu, dan mulai bermain tanpa mengunduh file game berukuran besar.
      </p>

      <div class="ax-hero-actions">
        <a href="/pricing?ref_=home_hero_pricing" class="ax-btn-hero-primary">
          <i class="fas fa-play"></i> Mulai Bermain
        </a>
        <a href="/games?ref_=home_hero_games" class="ax-btn-hero-secondary">
          <i class="fas fa-gamepad"></i> Lihat <%= typeof totalGamesCount !== 'undefined' ? totalGamesCount : '' %> Game
        </a>
      </div>

      <div class="ax-trust-row">
        <span><i class="fas fa-check-circle"></i> Bayar lewat QRIS</span>
        <span><i class="fas fa-check-circle"></i> Tanpa download game</span>
        <span><i class="fas fa-check-circle"></i> HP, laptop &amp; TV</span>
      </div>

      <!-- Logged-in User Bento Member Bar -->
      <% if (typeof user !== 'undefined' && user) { %>
      <div class="ax-member-bento">
        <!-- Saldo Wallet with Reliable Inline SVG Icon -->
        <div class="ax-wallet-card">
          <div class="ax-wallet-info">
            <div class="ax-wallet-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a8 8 0 0 1-5.3 7.7 2 2 0 0 1-2.7-1.4l-1-4.2a2 2 0 0 0-1.7-1.5L5 16a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h14"></path>
                <path d="M21 11v4h-3a2 2 0 0 1 0-4h3z"></path>
              </svg>
            </div>
            <div>
              <div class="ax-wallet-lbl">Saldo Akun</div>
              <div id="heroWalletBalance" class="ax-wallet-val">Rp <%= (balance || 0).toLocaleString('id-ID') %></div>
            </div>
          </div>
          <a href="/wallet?ref_=home_wallet_topup" class="ax-topup-btn">
            <i class="fas fa-plus"></i> Top Up
          </a>
        </div>

        <!-- 7-Day Daily Login Streak -->
        <% 
           let today = new Date();
           today.setUTCHours(0,0,0,0);
           let todayDate = today.toISOString().split('T')[0];
           let alreadyClaimed = lastDailyLogin === todayDate;
           let currentStreak = loginStreak || 0;
           let nextStreak = alreadyClaimed ? currentStreak : (currentStreak + 1 > 7 ? 1 : currentStreak + 1);
           const rewardMap = { 1: '1k', 2: '2k', 3: '3k', 4: '4k', 5: '5k', 6: '7k', 7: '10k' };
        %>
        <div class="ax-streak-card">
          <div class="ax-streak-top">
            <div class="ax-streak-title">
              <i class="fas fa-fire" style="color:#fbbf24;"></i> 7-Day Login Streak
            </div>
            <% if (alreadyClaimed) { %>
              <span style="font-size:0.7rem; color:#10b981; font-weight:700;"><i class="fas fa-check-circle"></i> Hari Ini Diklaim</span>
            <% } else { %>
              <button id="btnDailyLogin" onclick="claimDailyLogin()" class="ax-streak-claim-btn">
                <i class="fas fa-gift"></i> Klaim Hadiah
              </button>
            <% } %>
          </div>
          <div class="ax-streak-days">
            <% for(let i=1; i<=7; i++) { 
               let status = 'future';
               if (i < nextStreak || (i === nextStreak && alreadyClaimed)) status = 'passed';
               else if (i === nextStreak && !alreadyClaimed) status = 'today';
            %>
            <div class="ax-day-pill <%= status %>">
              <div>H<%= i %></div>
              <div><%= rewardMap[i] %></div>
            </div>
            <% } %>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Hero Stats Counter -->
      <div class="ax-hero-stats">
        <div class="ax-stat-card">
          <div class="ax-stat-val"><%= typeof totalGamesCount !== 'undefined' ? totalGamesCount : '—' %></div>
          <div class="ax-stat-lbl">Game Tersedia</div>
        </div>
        <div class="ax-stat-card">
          <div class="ax-stat-val">QRIS</div>
          <div class="ax-stat-lbl">Pembayaran</div>
        </div>
        <div class="ax-stat-card">
          <div class="ax-stat-val">Multi</div>
          <div class="ax-stat-lbl">Perangkat</div>
        </div>
        <div class="ax-stat-card">
          <div class="ax-stat-val">Admin</div>
          <div class="ax-stat-lbl">Bantuan</div>
        </div>
      </div>
    </div>

    <!-- Right Hero Column - Live Rig Showcase -->
    <div class="hero-visual">
      <div class="ax-rig-showcase">
        <div class="ax-rig-header">
          <div class="ax-rig-title">
            <img src="/images/logo-circular.png" alt="AlexCloud" width="24" height="24" style="border-radius:50%; border:1.5px solid #fbbf24; box-shadow:0 0 8px rgba(251,191,36,0.4);">
            <span>PILIHAN GAME ALEXCLOUD</span>
          </div>
          <div class="ax-rig-beacon">
            <span class="ax-live-dot"></span>
            <span>TERSEDIA DI CLOUD</span>
          </div>
        </div>

        <div class="ax-dual-games">
          <!-- EA FC 26 Card -->
          <div class="ax-game-preview-card" style="--game-art: url('/images/games/ea_fc_26.webp');">
            <img src="/images/games/ea_fc_26.webp" onerror="this.src='/images/games/ea_fc_25.webp'" alt="EA SPORTS FC 26" class="ax-game-preview-img" width="400" height="400" loading="eager" decoding="async" fetchpriority="high">
            <div class="ax-game-preview-overlay">
              <div class="ax-game-preview-tag"><i class="fas fa-cloud" aria-hidden="true"></i> CLOUD READY</div>
              <div class="ax-game-preview-name">EA SPORTS FC™ 26</div>
            </div>
          </div>

          <!-- GTA V Ray Tracing -->
          <div class="ax-game-preview-card" style="--game-art: url('/images/games/gta_v.webp');">
