<%- include('partials/header') %>

<div class="page-wrap">
  <div style="padding: 3.5rem 0 2rem; background: linear-gradient(180deg, rgba(251,191,36,0.06) 0%, transparent 100%);">
    <div class="container text-center">
      <div style="display:inline-flex; align-items:center; gap:0.4rem; background:rgba(251,191,36,0.12); border:1px solid rgba(251,191,36,0.3); color:#fbbf24; font-family:var(--font-ui); font-size:0.78rem; font-weight:700; padding:0.3rem 0.85rem; border-radius:100px; margin-bottom:1rem; box-shadow:0 0 15px rgba(251,191,36,0.15);">
        <i class="fas fa-bolt"></i> ALEXCLOUD GAMING SUBSCRIPTION
      </div>
      <h1 class="section-title">Pilih <span class="accent">Paket Gaming</span> Terbaik</h1>
      <p class="section-desc">Pilih durasi akses yang sesuai. Katalog saat ini berisi <%= gameCount %> game dan dapat berubah mengikuti ketersediaan.</p>
    </div>
  </div>

  <section class="pricing-section" style="padding-top: 1rem; padding-bottom: 4rem;">
    <div class="pricing-container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.25rem;">
      
      <!-- TIER 1: 4 CORE SUBSCRIPTION PLANS -->
      <div class="sub-plans-grid">
        <% plans.forEach(plan => { %>
          <div class="plan-card <%= plan.popular ? 'popular' : '' %>" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
            <div>
              <div class="popular-badge-wrap" style="min-height: 24px; display: flex; align-items: center; margin-bottom: 0.35rem;">
                <% if (plan.popular) { %>
                  <div class="popular-badge" style="margin: 0; background: linear-gradient(90deg, #fbbf24, #f59e0b); color: #000; font-weight: 800; font-size: 0.68rem; letter-spacing: 0.04em; padding: 0.2rem 0.6rem; border-radius: 100px;">⭐ PALING POPULER</div>
                <% } %>
              </div>
              
              <div class="plan-name" style="font-size: 1.1rem; font-weight: 700;"><%= plan.name %></div>
              <div class="plan-price <%= plan.popular ? 'popular-price' : '' %>" style="font-size: 1.75rem; font-weight: 800; line-height: 1.1; margin-top: 0.15rem;"><%= plan.priceDisplay %></div>
              <div class="plan-period" style="font-size:0.78rem; margin-bottom:0.35rem; color:var(--text-muted);">akses <%= plan.duration %> hari</div>

              <!-- Daily Breakdown Chip -->
              <% 
                let dailyCost = Math.round(plan.price / plan.duration);
                let isUltimate = plan.id.includes('ultimate');
              %>
              <div class="daily-chip <%= plan.popular ? 'highlight' : '' %> <%= isUltimate ? 'gold' : '' %>" style="display:inline-flex; align-items:center; gap:0.25rem; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); color:var(--text-secondary); font-size:0.7rem; font-weight:600; padding:0.18rem 0.5rem; border-radius:6px; margin-bottom:0.65rem;">
                <% if(isUltimate) { %>👑<% } else { %>🔥<% } %> Rp <%= dailyCost.toLocaleString('id-ID') %> / hari
              </div>

              <ul class="plan-features" style="gap:0.4rem; margin-bottom:1.1rem;">
                <% if (plan.id.includes('ultimate')) { %>
                  <li><i class="fas fa-check-circle" style="color:#fbbf24;"></i> Akses ratusan game premium & baru</li>
                  <li><i class="fas fa-check-circle" style="color:#fbbf24;"></i> Grafis Ultra (Resolusi 4K & 60fps)</li>
                  <li><i class="fas fa-check-circle" style="color:#fbbf24;"></i> Prioritas Antrean (VIP Access)</li>
                  <li><i class="fas fa-check-circle" style="color:#fbbf24;"></i> Multi-device (HP, PC, Smart TV)</li>
                  <li><i class="fas fa-check-circle" style="color:#fbbf24;"></i> Masa aktif <%= plan.duration %> hari</li>
                <% } else { %>
                  <li><i class="fas fa-check-circle" style="color:var(--accent-green)"></i> Akses katalog game standar</li>
                  <li><i class="fas fa-check-circle" style="color:var(--accent-green)"></i> Kualitas HD / 60fps</li>
                  <li><i class="fas fa-check-circle" style="color:var(--accent-green)"></i> Multi-device (HP & PC)</li>
                  <li><i class="fas fa-check-circle" style="color:var(--accent-green)"></i> Tanpa download file game</li>
                  <li><i class="fas fa-check-circle" style="color:var(--accent-green)"></i> Masa aktif <%= plan.duration %> hari</li>
                <% } %>
              </ul>
            </div>

            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/order/<%= plan.id %>?ref_=pricing_buy" class="plan-btn <%= plan.popular ? 'filled' : 'outline' %>" style="font-size:0.82rem; padding:0.65rem 0.75rem;">
                <i class="fas fa-shopping-cart"></i> Pilih Paket
              </a>
            <% } else { %>
              <a href="/login?ref_=pricing_login" class="plan-btn <%= plan.popular ? 'filled' : 'outline' %>" style="font-size:0.82rem; padding:0.65rem 0.75rem;">
                Login Order
              </a>
            <% } %>
          </div>
        <% }) %>
      </div>

      <!-- FAQ / Info Grid -->
      <div style="margin-top:3.5rem; display:grid; grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); gap:1.25rem;">
        <div style="background:linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(15,16,20,0.95) 100%); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.5rem;">
          <div style="font-size:1.4rem; margin-bottom:0.5rem;">💳</div>
          <h4 style="font-family:var(--font-ui); margin-bottom:0.35rem; font-size:1rem;">Metode Pembayaran</h4>
          <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.4;">QRIS Otomatis (GoPay, OVO, DANA, ShopeePay, M-Banking, dan e-wallet).</p>
        </div>
        <div style="background:linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(15,16,20,0.95) 100%); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.5rem;">
          <div style="font-size:1.4rem; margin-bottom:0.5rem;">⚡</div>
          <h4 style="font-family:var(--font-ui); margin-bottom:0.35rem; font-size:1rem;">Aktivasi Cepat</h4>
          <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.4;">Akun aktif serba otomatis dalam 1-5 menit setelah pembayaran selesai.</p>
        </div>
        <div style="background:linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(15,16,20,0.95) 100%); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.5rem;">
          <div style="font-size:1.4rem; margin-bottom:0.5rem;">🔄</div>
          <h4 style="font-family:var(--font-ui); margin-bottom:0.35rem; font-size:1rem;">Perpanjangan Mudah</h4>
          <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.4;">Perpanjang kapanpun lewat dashboard. Masa aktif otomatis terakumulasi.</p>
        </div>
        <div style="background:linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(15,16,20,0.95) 100%); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.5rem;">
          <div style="font-size:1.4rem; margin-bottom:0.5rem;">🎮</div>
          <h4 style="font-family:var(--font-ui); margin-bottom:0.35rem; font-size:1rem;">Semua Game Termasuk</h4>
          <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.4;">Satu paket memberi akses ke katalog game yang tersedia selama masa aktif.</p>
        </div>
      </div>

      <!-- CTA WhatsApp -->
      <div style="text-align:center; margin-top:2.5rem; padding:2rem; background:rgba(37,211,102,0.04); border:1px solid rgba(37,211,102,0.18); border-radius:var(--radius-lg);">
        <h3 style="font-family:var(--font-display); margin-bottom:0.35rem; font-size:1.2rem;">Butuh Bantuan Pilih Paket?</h3>
        <p style="color:var(--text-muted); margin-bottom:1.25rem; font-size:0.88rem;">Butuh bantuan memilih paket? Hubungi admin melalui WhatsApp.</p>
        <a href="https://wa.me/62<%= process.env.WA_NUMBER ? process.env.WA_NUMBER.replace(/^0/,'') : '85810073341' %>" target="_blank" class="wa-btn" style="display:inline-flex; width:auto; padding:0.75rem 1.75rem; font-size:0.9rem;">
          <i class="fab fa-whatsapp" style="font-size:1.1rem;"></i> Chat Admin WhatsApp
        </a>
      </div>
    </div>
  </section>
</div>

<%- include('partials/footer') %>


