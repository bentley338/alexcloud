<style>
/* ─── Ultra-Premium Gold/Yellow Fintech Payment Styles ─── */
:root {
  --gold-primary: #facc15;
  --gold-bright: #fde047;
  --gold-dark: #ca8a04;
  --gold-amber: #d97706;
  --gold-gradient: linear-gradient(135deg, #fde047 0%, #eab308 50%, #ca8a04 100%);
  --gold-glow: 0 4px 22px rgba(234, 179, 8, 0.4);
  --gold-border: rgba(234, 179, 8, 0.25);
  --gold-bg-soft: rgba(234, 179, 8, 0.08);
}

.pay-page-wrapper {
  min-height: 100vh;
  padding: 6.5rem 1.25rem 4rem;
  background: radial-gradient(circle at 50% 8%, rgba(234, 179, 8, 0.1) 0%, transparent 60%),
              radial-gradient(circle at 85% 25%, rgba(245, 158, 11, 0.05) 0%, transparent 50%),
              #070a12;
  color: #f8fafc;
  font-family: var(--font-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
}

.pay-container {
  max-width: 500px;
  margin: 0 auto;
}

/* Stepper */
.checkout-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.4rem;
  padding: 0.65rem 0.9rem;
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid var(--gold-border);
  border-radius: 14px;
  backdrop-filter: blur(12px);
}
.step-item {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.78rem;
  font-weight: 800;
  color: #64748b;
}
.step-item.active { color: #fde047; }
.step-item.done { color: #10b981; }
.step-num {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  font-weight: 900;
}
.step-item.active .step-num {
  background: #fde047;
  color: #070a12;
  box-shadow: 0 0 10px rgba(253, 224, 71, 0.5);
}
.step-item.done .step-num {
  background: #10b981;
  color: #070a12;
}
.step-divider {
  flex: 1;
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
  margin: 0 0.45rem;
}

/* Nav Bar */
.pay-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.2rem;
}
.pay-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: #94a3b8;
  text-decoration: none;
  font-size: 0.82rem;
  font-weight: 700;
  padding: 0.35rem 0.7rem;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: all 0.2s ease;
}
.pay-back-btn:hover {
  color: #fde047;
  background: rgba(234, 179, 8, 0.1);
  border-color: rgba(234, 179, 8, 0.3);
}
.pay-order-tag {
  font-size: 0.78rem;
  font-weight: 800;
  color: #fde047;
  background: rgba(234, 179, 8, 0.1);
  border: 1px solid rgba(234, 179, 8, 0.25);
  padding: 0.35rem 0.65rem;
  border-radius: 8px;
  font-family: var(--font-display, monospace);
}

/* Main Fintech Card */
.pay-card {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--gold-border);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.7), 0 0 25px rgba(234, 179, 8, 0.05);
  backdrop-filter: blur(16px);
  margin-bottom: 1.15rem;
  position: relative;
}
.pay-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2.5px;
  background: var(--gold-gradient);
}

/* Status Header Bar */
.pay-status-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 1.15rem;
  background: rgba(255, 255, 255, 0.02);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 0.84rem;
  font-weight: 800;
}
.status-left {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.status-pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #fde047;
  box-shadow: 0 0 10px #fde047;
  animation: dotBlink 1.4s ease-in-out infinite;
}
.status-pulse-dot.success {
  background: #10b981;
  box-shadow: 0 0 10px #10b981;
  animation: none;
}
.status-pulse-dot.expired {
  background: #ef4444;
  box-shadow: 0 0 10px #ef4444;
  animation: none;
}
@keyframes dotBlink {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.35; transform: scale(0.85); }
}

.pay-timer-pill {
  font-size: 0.8rem;
  font-weight: 900;
  color: #fde047;
  background: rgba(234, 179, 8, 0.12);
  border: 1px solid rgba(234, 179, 8, 0.35);
  padding: 0.2rem 0.55rem;
  border-radius: 6px;
  font-family: var(--font-display, monospace);
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}

/* Summary Box */
.pay-summary-box {
  padding: 1.15rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
.pay-sum-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.35rem 0;
  font-size: 0.84rem;
  color: #94a3b8;
}
.pay-sum-line strong {
  color: #f1f5f9;
}
.pay-total-line {
  margin-top: 0.65rem;
  padding-top: 0.75rem;
  border-top: 1px dashed rgba(255, 255, 255, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.pay-total-label {
  font-size: 0.88rem;
  font-weight: 800;
  color: #ffffff;
}
.pay-total-val {
  font-size: 1.4rem;
  font-weight: 900;
  color: #fde047;
  letter-spacing: -0.02em;
  text-shadow: 0 0 15px rgba(253, 224, 71, 0.25);
}

/* Voucher Trigger Mini Card */
.voucher-trigger-card {
  margin: 0.85rem 1.15rem 0.4rem;
  background: linear-gradient(135deg, rgba(234, 179, 8, 0.1) 0%, rgba(217, 119, 6, 0.04) 100%);
  border: 1px dashed rgba(234, 179, 8, 0.45);
  border-radius: 12px;
  padding: 0.75rem 0.95rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  cursor: pointer;
  transition: all 0.2s ease;
}
.voucher-trigger-card:hover {
  border-color: #fde047;
  background: linear-gradient(135deg, rgba(234, 179, 8, 0.16) 0%, rgba(217, 119, 6, 0.08) 100%);
}
.voucher-trig-left {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}
.voucher-trig-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: var(--gold-gradient);
  color: #070a12;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  flex-shrink: 0;
  font-weight: 900;
}
.voucher-trig-title {
  font-weight: 800;
  font-size: 0.82rem;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 0.35rem;
}
.voucher-badge-active {
  font-size: 0.62rem;
  background: #fde047;
  color: #070a12;
  font-weight: 900;
  padding: 0.1rem 0.35rem;
  border-radius: 4px;
}
.voucher-trig-desc {
  font-size: 0.72rem;
  color: #fef08a;
  margin-top: 0.1rem;
}
.voucher-trig-btn {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  color: #fde047;
  font-size: 0.76rem;
  font-weight: 900;
  white-space: nowrap;
}

/* Method Selector */
.methods-container {
  padding: 1rem 1.15rem 0.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}
.method-choice-card {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  width: 100%;
  padding: 0.85rem 1rem;
  background: rgba(255, 255, 255, 0.025);
  border: 1.5px solid var(--gold-border);
  border-radius: 14px;
  cursor: pointer;
  text-align: left;
  transition: all 0.2s ease;
  color: #f8fafc;
  font-family: inherit;
}
.method-choice-card:hover {
  border-color: #fde047;
  background: rgba(234, 179, 8, 0.08);
}
.method-choice-card.active {
  border-color: #fde047;
  background: rgba(234, 179, 8, 0.12);
  box-shadow: 0 0 0 1px #fde047 inset;
}
.method-choice-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: rgba(253, 224, 71, 0.15);
  color: #fde047;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  flex-shrink: 0;
}
.method-choice-body {
  flex: 1;
  min-width: 0;
}
.method-choice-title {
  font-weight: 800;
  font-size: 0.88rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.instan-pill {
  background: rgba(253, 224, 71, 0.15);
  border: 1px solid rgba(253, 224, 71, 0.4);
  color: #fde047;
  font-size: 0.62rem;
  font-weight: 900;
  padding: 0.1rem 0.4rem;
  border-radius: 6px;
}
.method-choice-sub {
  font-size: 0.72rem;
  color: #94a3b8;
  margin-top: 0.15rem;
}
.method-logos-wrap {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  margin-top: 0.45rem;
  flex-wrap: wrap;
}
.method-logo-chip {
  background: #ffffff;
  border-radius: 4px;
  padding: 2px 5px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 18px;
}
.method-logo-chip svg {
  height: 12px;
  max-width: 38px;
  display: block;
}
.method-radio-indicator {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}
.method-choice-card.active .method-radio-indicator {
  border-color: #fde047;
  background: #fde047;
  color: #070a12;
}

/* Primary Yellow/Gold Action Button */
.btn-pay-primary {
  width: 100%;
  height: 48px;
  background: var(--gold-gradient);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  color: #070a12;
  font-size: 0.92rem;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  cursor: pointer;
  box-shadow: var(--gold-glow);
  transition: all 0.2s ease;
  text-decoration: none;
  font-family: inherit;
}
.btn-pay-primary:hover:not(:disabled) {
  background: linear-gradient(135deg, #fef08a 0%, #facc15 50%, #eab308 100%);
  transform: translateY(-1px);
  box-shadow: 0 6px 26px rgba(234, 179, 8, 0.55);
}
.btn-pay-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  box-shadow: none;
}

.btn-pay-secondary {
  width: 100%;
  height: 42px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 11px;
  color: #cbd5e1;
  font-size: 0.82rem;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  cursor: pointer;
  transition: all 0.2s ease;
  text-decoration: none;
  font-family: inherit;
}
.btn-pay-secondary:hover {
  background: rgba(234, 179, 8, 0.1);
  color: #fde047;
  border-color: rgba(234, 179, 8, 0.3);
}

.btn-pay-danger-link {
  width: 100%;
  background: none;
  border: none;
  color: #f87171;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.6rem;
  cursor: pointer;
  transition: color 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
}
.btn-pay-danger-link:hover { color: #ef4444; }

/* QRIS Display Container */
.qris-display-wrap {
  padding: 1.4rem 1.15rem;
  text-align: center;
}
.qris-badge-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
}
.qris-card-white {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 16px;
  padding: 0.75rem;
  margin: 0 auto 1.1rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 20px rgba(234, 179, 8, 0.15);
}
.qris-expired-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.9);
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  color: #f87171;
  padding: 1rem;
}
.qris-amount-hero {
  font-size: 1.75rem;
  font-weight: 900;
  color: #fde047;
  letter-spacing: -0.02em;
  margin-bottom: 0.25rem;
  text-shadow: 0 0 15px rgba(253, 224, 71, 0.25);
}
.qris-copy-hint {
  font-size: 0.78rem;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  margin-bottom: 1.1rem;
}

/* Instructions Accordion / Steps */
.pay-guide-box {
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 14px;
  padding: 1rem;
  margin: 1rem 1.15rem;
  text-align: left;
}
.pay-guide-title {
  font-size: 0.82rem;
  font-weight: 800;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-bottom: 0.65rem;
}
.pay-steps-list {
  padding-left: 1.1rem;
  margin: 0;
  font-size: 0.78rem;
  color: #94a3b8;
  line-height: 1.6;
}
.pay-steps-list li { margin-bottom: 0.3rem; }
.pay-steps-list strong { color: #cbd5e1; }

/* WhatsApp Helper Minimal Bar */
.wa-helper-bar {
  margin: 0.85rem 1.15rem;
  padding: 0.75rem 0.95rem;
  background: linear-gradient(135deg, rgba(37, 211, 102, 0.08) 0%, rgba(18, 140, 126, 0.03) 100%);
  border: 1px dashed rgba(37, 211, 102, 0.35);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.65rem;
  flex-wrap: wrap;
}
.wa-helper-text {
  font-size: 0.76rem;
  color: #cbd5e1;
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex: 1;
  min-width: 170px;
}
.wa-helper-text i {
  color: #25d366;
  font-size: 1.05rem;
}
.wa-helper-link {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  background: #25d366;
  color: #030712;
  font-weight: 800;
  font-size: 0.72rem;
  padding: 0.35rem 0.7rem;
  border-radius: 7px;
  text-decoration: none;
  white-space: nowrap;
  transition: all 0.2s;
}
.wa-helper-link:hover {
  background: #22c55e;
  transform: translateY(-1px);
}

/* Success Receipt Screen */
.success-screen-box {
  padding: 1.75rem 1.25rem;
  text-align: center;
}
.success-check-badge {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(253, 224, 71, 0.15);
  border: 2px solid #fde047;
  color: #fde047;
  font-size: 1.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.1rem;
  box-shadow: 0 0 25px rgba(253, 224, 71, 0.4);
}
.success-head-title {
  font-size: 1.35rem;
  font-weight: 900;
  color: #ffffff;
  margin-bottom: 0.35rem;
}
.success-head-sub {
  font-size: 0.82rem;
  color: #94a3b8;
  margin-bottom: 1.4rem;
}
.success-receipt-card {
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  padding: 0.85rem 1rem;
  margin-bottom: 1.25rem;
  text-align: left;
}
.success-receipt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.4rem 0;
  font-size: 0.82rem;
  color: #94a3b8;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}
.success-receipt-row:last-child { border-bottom: none; }
.success-receipt-row span:first-child { display: flex; align-items: center; gap: 0.4rem; }
.success-receipt-row i { color: #fde047; width: 14px; }

.wa-claim-box {
  background: linear-gradient(135deg, rgba(37, 211, 102, 0.1) 0%, rgba(18, 140, 126, 0.05) 100%);
  border: 1.5px solid rgba(37, 211, 102, 0.35);
  border-radius: 14px;
  padding: 1.1rem;
  margin-bottom: 1.25rem;
  text-align: center;
}
.wa-claim-title {
  font-size: 0.92rem;
  font-weight: 800;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  margin-bottom: 0.4rem;
}
.wa-claim-desc {
