<% if (payState === 'instrument') { %>
<script src="/js/qrcode.min.js" onerror="(function(){var s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';document.head.appendChild(s);})()"></script>
<script>
const ORDER_ID = <%- JSON.stringify(order.orderId) %>;
const QR_STRING = <%- JSON.stringify(order.fr3QrString || '') %>;
const EXPIRY = <%- order.fr3Expiry ? (typeof order.fr3Expiry === 'number' ? order.fr3Expiry : new Date(order.fr3Expiry).getTime()) : (Date.now() + 10 * 60 * 1000) %>;

let pollInterval;
let timerInterval;
let isCancelled = false;

function qrServerFallback(target) {
  const img = document.createElement('img');
  img.width = 210; img.height = 210; img.alt = 'QRIS Code';
  img.style.cssText = 'border-radius:8px; display:block;';
  img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=210x210&ecc=M&data=' + encodeURIComponent(QR_STRING);
  img.onerror = function () {
    target.innerHTML = '<div style="color:#94a3b8; font-size:0.8rem; text-align:center;"><i class="fas fa-exclamation-circle"></i><br>QR gagal dimuat</div>';
  };
  target.innerHTML = '';
  target.appendChild(img);
}

function renderQR() {
  const target = document.getElementById('qrRender');
  if (!target || !QR_STRING) return;
  if (typeof QRCode !== 'undefined') {
    try {
      target.innerHTML = '';
      new QRCode(target, {
        text: QR_STRING,
        width: 210,
        height: 210,
        colorDark: '#000000',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.M
      });
      return;
    } catch(e) {}
  }
  qrServerFallback(target);
}

// Download QRIS button
const saveQrBtn = document.getElementById('saveQrBtn');
if (saveQrBtn) {
  saveQrBtn.addEventListener('click', () => {
    const target = document.getElementById('qrRender');
    if (!target) return;
    const canvas = target.querySelector('canvas');
    const img = target.querySelector('img');
    let dataUrl = canvas ? canvas.toDataURL('image/png') : (img ? img.src : '');
    if (!dataUrl) {
      alert('QR belum siap.');
      return;
    }
    const a = document.createElement('a');
    a.href = dataUrl;
    a.download = 'QRIS-AlexCloud-' + ORDER_ID + '.png';
    document.body.appendChild(a);
    a.click();
    setTimeout(() => document.body.removeChild(a), 100);
  });
}

function markExpired() {
  clearInterval(timerInterval);
  clearInterval(pollInterval);
  const t = document.getElementById('payTimer'); if (t) t.textContent = '00:00';
  const ov = document.getElementById('qrExpired'); if (ov) ov.style.display = 'flex';
  const dot = document.getElementById('statusDot'); if (dot) dot.className = 'status-pulse-dot expired';
  const st = document.getElementById('statusText'); if (st) st.textContent = 'Kadaluarsa';
}

function startTimer() {
  timerInterval = setInterval(() => {
    const remaining = EXPIRY - Date.now();
    if (remaining <= 0) { markExpired(); return; }
    const m = Math.floor(remaining / 60000);
    const s = Math.floor((remaining % 60000) / 1000);
    const t = document.getElementById('payTimer');
    if (t) t.textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  }, 1000);
}

function startPolling() {
  pollInterval = setInterval(checkStatus, 5000);
}

async function checkStatus() {
  if (isCancelled) return false;
  try {
    const r = await fetch(`/api/payment/status/${ORDER_ID}`);
    const data = await r.json();
    const st = (data.fr3Status || '').toUpperCase();
    if (st === 'SUCCESS' || st === 'PAID' || st === 'SETTLED' || data.status === 'confirmed' || data.paid === true) {
      clearInterval(pollInterval);
      clearInterval(timerInterval);
      showSuccessState();
      return true;
    } else if (st === 'EXPIRED' || data.status === 'expired') {
      markExpired();
      return 'expired';
    }
    return false;
  } catch(e) {
    return 'error';
  }
}

async function manualCheckStatus(btn) {
  if (!btn || btn.disabled) return;
  const orig = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengecek...';
  const res = await checkStatus();
  if (res === true) {
    // success
  } else if (res === 'expired') {
    alert('Sesi pembayaran telah kadaluarsa.');
  } else if (res === 'error') {
    alert('Gagal mengecek status. Coba lagi sebentar.');
  } else {
    alert('Pembayaran belum terdeteksi. Pastikan transfer sudah berhasil dilakukan.');
  }
  setTimeout(() => {
    btn.disabled = false;
    btn.innerHTML = orig;
  }, 1000);
}

function showSuccessState() {
  clearInterval(pollInterval);
  clearInterval(timerInterval);

  const card = document.querySelector('.pay-card');
  if (card) {
    Array.from(card.children).forEach(child => {
      if (child.id !== 'successState') child.style.display = 'none';
    });
  }
  const succ = document.getElementById('successState');
  if (succ) succ.style.display = 'block';

  setTimeout(() => {
    window.location.href = `/payment/${ORDER_ID}`;
  }, 500);
}

function cancelPayment() {
  document.getElementById('cancelConfirmModal').style.display = 'flex';
}
function closeCancelModal() {
  document.getElementById('cancelConfirmModal').style.display = 'none';
}
async function confirmCancelPayment() {
  closeCancelModal();
  isCancelled = true;
  clearInterval(pollInterval);
  clearInterval(timerInterval);
  try {
    await fetch(`/api/payment/cancel/${ORDER_ID}`, { method: 'POST' });
    window.location.href = '/dashboard';
  } catch(e) {
    window.location.href = '/dashboard';
  }
}

if (QR_STRING) renderQR();
startTimer();
startPolling();
setTimeout(checkStatus, 2000);
</script>
<% } %>

<!-- SHOPEE VOUCHER MODAL SCRIPT -->
<script>
var currentOrderPrice = <%= (typeof order !== 'undefined' && order.price) ? order.price : (typeof plan !== 'undefined' && plan ? plan.price : 0) %>;
var currentOrderId = "<%= (typeof order !== 'undefined' && order.orderId) ? order.orderId : '' %>";

window.openShopeeVoucherModal = function() {
  var m = document.getElementById('shopeeModalOverlay');
  if (m) m.style.display = 'flex';
  loadAvailableVouchers();
};

window.closeShopeeVoucherModal = function() {
  var m = document.getElementById('shopeeModalOverlay');
  if (m) m.style.display = 'none';
};

async function loadAvailableVouchers() {
  var container = document.getElementById('shopeeModalVoucherList');
  if (!container) return;
  try {
    var res = await fetch('/api/vouchers/available?planPrice=' + currentOrderPrice + '&orderId=' + encodeURIComponent(currentOrderId) + '&_t=' + Date.now());
    var data = await res.json();
    if (!data.success || !data.vouchers || data.vouchers.length === 0) {
      container.innerHTML = '<div style="text-align:center; padding:2rem 1rem; color:#94a3b8; font-size:0.85rem;">Belum ada voucher tersedia.</div>';
      return;
    }

    var html = '';
    data.vouchers.forEach(function(v) {
      var isEligible = v.isEligible;
      var discLabel = v.discountType === 'percent' ? (v.discountValue + '%') : ('Rp ' + Math.round((v.discountValue||0)/1000) + 'K');
      
      html += '<div class="shopee-ticket-card ' + (isEligible ? 'eligible' : 'ineligible') + '" onclick="handleTicketClick(\'' + v.code + '\', ' + isEligible + ', ' + v.calculatedDiscount + ', \'' + (v.ineligibilityReason || '') + '\')">';
      html += '  <div class="ticket-left">';
      html += '    <div style="font-size:1.15rem; font-weight:900; line-height:1.1;">' + discLabel + '</div>';
      html += '    <div style="font-size:0.62rem; font-weight:800; text-transform:uppercase; margin-top:0.2rem; opacity:0.9;">DISKON</div>';
      html += '  </div>';
      html += '  <div class="ticket-right">';
      html += '    <div style="font-weight:800; font-size:0.85rem; color:#fff; line-height:1.3;">' + v.title + '</div>';
      html += '    <div style="font-size:0.72rem; color:#94a3b8;">Min. Belanja: <strong style="color:#cbd5e1;">Rp ' + (v.minPurchase || 0).toLocaleString('id-ID') + '</strong></div>';
      if (!isEligible && v.ineligibilityReason) {
        html += '    <div style="font-size:0.7rem; color:#f87171; font-weight:700;">⚠️ ' + v.ineligibilityReason + '</div>';
      }
      html += '    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:0.25rem;">';
      html += '      <span style="font-size:0.68rem; color:#fde047; font-weight:800; background:rgba(234,179,8,0.15); padding:0.15rem 0.45rem; border-radius:4px;">' + v.code + '</span>';
      if (isEligible) {
        html += '      <span style="font-size:0.72rem; color:#fde047; font-weight:800;">Gunakan ➔</span>';
      } else {
        html += '      <span style="font-size:0.68rem; color:#64748b; font-weight:700;">Terkunci</span>';
      }
      html += '    </div>';
      html += '  </div>';
      html += '</div>';
    });

    container.innerHTML = html;
  } catch(e) {
    container.innerHTML = '<div style="text-align:center; padding:2rem 1rem; color:#f87171; font-size:0.85rem;">Gagal memuat voucher.</div>';
  }
}

window.handleTicketClick = function(code, isEligible, discountAmt, reason) {
  if (!isEligible) {
    if (reason && reason.includes('Royal VIP')) {
      alert('👑 VOUCHER ROYAL VIP CLUB\n\nVoucher ' + code + ' khusus untuk Member Royal VIP.');
    } else if (reason) {
      alert('⚠️ ' + reason);
    }
    return;
  }
  selectVoucher(code, discountAmt);
};

window.selectVoucher = async function(code, discountAmt) {
  if (currentOrderId) {
    try {
      var metaToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      var res = await fetch('/api/payment/apply-voucher', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': metaToken },
        body: JSON.stringify({ orderId: currentOrderId, promoCode: code })
      });
      var data = await res.json();
      if (data.success) {
        alert('🎉 ' + data.message);
        window.location.reload();
        return;
      } else {
        alert('⚠️ ' + (data.message || 'Gagal menerapkan voucher'));
        return;
      }
    } catch(e) {
      alert('⚠️ Terjadi gangguan koneksi ke server.');
      return;
    }
  }
  closeShopeeVoucherModal();
};

window.applyManualVoucherCode = async function() {
  var code = (document.getElementById('manualVoucherInput')?.value || '').trim();
  if (!code) return;
  if (currentOrderId) {
    selectVoucher(code, 0);
  }
};

window.clearSelectedVoucher = async function() {
  if (currentOrderId) {
    try {
      var metaToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      await fetch('/api/payment/apply-voucher', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': metaToken },
        body: JSON.stringify({ orderId: currentOrderId, promoCode: '' })
      });
      window.location.reload();
    } catch(e) {}
  }
  closeShopeeVoucherModal();
};
</script>

