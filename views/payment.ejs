<!-- SCRIPTS -->
<% if (payState === 'select') { %>
<script>
const SEL_ORDER_ID = <%- JSON.stringify(order.orderId) %>;
let selectedMethod = 'qris';

window.selectPaymentMethod = function(method) {
  selectedMethod = method;
};

async function proceedPayment() {
  const btn = document.getElementById('createBtn');
  const errBox = document.getElementById('createError');
  if (errBox) errBox.style.display = 'none';
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyiapkan QRIS...';
  }

  try {
    const metaToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
    const r = await fetch(`/api/payment/create/${SEL_ORDER_ID}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': metaToken
      },
      body: JSON.stringify({ method: 'qris' })
    });
    const data = await r.json();
    if (r.ok && (data.ok || data.fallback || data.success)) {
      window.location.reload();
    } else {
      if (errBox) {
        errBox.textContent = data.error || 'Gagal menyiapkan pembayaran. Silakan coba lagi.';
        errBox.style.display = 'block';
      }
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-bolt"></i> Coba Lagi <i class="fas fa-arrow-right"></i>';
      }
    }
  } catch (e) {
    if (errBox) {
      errBox.textContent = 'Kendala koneksi ke server. Silakan coba lagi.';
      errBox.style.display = 'block';
    }
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-bolt"></i> Coba Lagi <i class="fas fa-arrow-right"></i>';
    }
  }
}
</script>
