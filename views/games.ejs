<%- include('partials/header') %>

<main class="library-shell" id="main-content">
  <section class="library-hero">
    <div class="container" style="text-align:center">
      <div class="library-eyebrow">Game Library</div>
      <h1 class="library-title">Temukan game yang ingin kamu mainkan.</h1>
      <p class="library-subtitle"><%= gameCount %> game tercatat di katalog AlexCloud. Cari berdasarkan judul atau jelajahi genre yang tersedia.</p>
      <form action="/games" method="GET" class="library-search" role="search">
        <label for="librarySearchInput" class="sr-only">Cari game</label>
        <input type="search" name="q" id="librarySearchInput" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" placeholder="Cari judul atau genre..." autocomplete="off">
        <button type="submit" class="btn-primary" aria-label="Cari game"><i class="fas fa-search" aria-hidden="true"></i><span>Cari</span></button>
      </form>
    </div>
  </section>

  <section class="library-content">
    <div class="container">
      <div class="library-toolbar">
        <div class="library-count"><%= games.length %> hasil<% if (searchQuery) { %> untuk “<%= searchQuery %>”<% } %></div>
        <nav class="genre-list" aria-label="Filter genre game">
          <a href="/games" class="genre-chip <%= activeGenre === 'all' ? 'is-active' : '' %>">Semua</a>
          <% genres.forEach(genre => { %>
            <a href="/games?genre=<%= encodeURIComponent(genre) %>" class="genre-chip <%= activeGenre === genre ? 'is-active' : '' %>"><%= genre %></a>
          <% }) %>
        </nav>
      </div>

      <% if (games.length) { %>
        <div class="games-grid" id="libraryGamesGrid">
          <% games.forEach(game => { %>
            <% const hasImage = game.image && !game.image.includes('placehold.co'); %>
            <article class="game-card" data-name="<%= (game.name || '').toLowerCase() %>" data-genre="<%= (game.genre || '').toLowerCase() %>">
              <div class="game-img-wrap">
                <% if (hasImage) { %>
                  <img src="<%= game.image %>" alt="Sampul <%= game.name %>" width="300" height="400" loading="lazy" decoding="async" onerror="this.hidden=true;this.nextElementSibling.hidden=false">
                <% } %>
                <div class="game-img-fallback" <%= hasImage ? 'hidden' : '' %> style="width:100%;height:100%;display:grid;place-items:center;padding:18px;text-align:center;background:#171717">
                  <div><i class="fas fa-gamepad" style="display:block;color:var(--ax-orange);font-size:1.8rem;margin-bottom:12px" aria-hidden="true"></i><strong><%= game.name %></strong></div>
                </div>
                <% if (game.tag) { %><span class="game-tag"><%= game.tag %></span><% } %>
              </div>
              <div class="game-body">
                <h2 class="game-title"><%= game.name %></h2>
                <div class="game-genre"><%= game.genre || 'Game' %></div>
                <% if (game.description) { %><p class="game-desc"><%= game.description %></p><% } %>
              </div>
              <div class="game-footer">
                <span class="game-rating"><i class="fas fa-star" aria-hidden="true"></i> <%= game.rating || '—' %></span>
                <span class="game-platform"><i class="fas fa-cloud" aria-hidden="true"></i> Cloud</span>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="library-empty">
          <i class="fas fa-search" style="font-size:1.8rem;color:var(--ax-orange)" aria-hidden="true"></i>
          <h2 style="font-size:1.2rem;margin:16px 0 7px">Game tidak ditemukan</h2>
          <p style="margin:0 0 20px">Coba kata kunci lain atau kembali ke seluruh katalog.</p>
          <a href="/games" class="btn-secondary">Lihat semua game</a>
        </div>
      <% } %>

      <div class="library-cta">
        <div><h2 style="font-size:1.35rem;margin:0 0 7px">Sudah menemukan game pilihanmu?</h2><p style="margin:0">Pilih paket terlebih dahulu, lalu ikuti petunjuk aktivasi dari dashboard.</p></div>
        <a href="<%= user ? '/pricing?ref_=games_cta' : '/register?ref_=games_cta' %>" class="btn-primary"><%= user ? 'Lihat paket' : 'Buat akun' %> <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
