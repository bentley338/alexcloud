<%- include('partials/header') %>

<style>
/* ─── Ultra-Premium Gold/Yellow Fintech Order Styling ─── */
:root {
  --gold-primary: #facc15;
  --gold-bright: #fde047;
  --gold-dark: #ca8a04;
  --gold-amber: #d97706;
  --gold-gradient: linear-gradient(135deg, #fde047 0%, #eab308 50%, #ca8a04 100%);
  --gold-glow: 0 4px 20px rgba(234, 179, 8, 0.35);
  --gold-border: rgba(234, 179, 8, 0.22);
  --gold-bg-soft: rgba(234, 179, 8, 0.08);
}

.order-wrapper {
  min-height: 100vh;
  padding: 6.5rem 1.25rem 4rem;
  background: radial-gradient(circle at 50% 8%, rgba(234, 179, 8, 0.1) 0%, transparent 60%),
              radial-gradient(circle at 80% 30%, rgba(245, 158, 11, 0.05) 0%, transparent 50%),
              #070a12;
  color: #f8fafc;
  font-family: var(--font-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
}

.order-container {
  max-width: 520px;
  margin: 0 auto;
}

/* Back Link */
.order-back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: #94a3b8;
  text-decoration: none;
  font-size: 0.82rem;
  font-weight: 700;
  margin-bottom: 1.4rem;
  padding: 0.35rem 0.75rem;
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: all 0.2s ease;
}
.order-back-link:hover {
  color: #fde047;
  background: rgba(234, 179, 8, 0.1);
  border-color: rgba(234, 179, 8, 0.3);
  transform: translateX(-2px);
}

/* 3-Step Checkout Stepper */
.checkout-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
  padding: 0.7rem 1rem;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(234, 179, 8, 0.15);
  border-radius: 14px;
  backdrop-filter: blur(12px);
}
.step-item {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.78rem;
  font-weight: 800;
  color: #64748b;
}
.step-item.active {
  color: #fde047;
}
.step-item.done {
  color: #10b981;
}
.step-num {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  font-weight: 900;
}
.step-item.active .step-num {
  background: #fde047;
  color: #070a12;
  box-shadow: 0 0 12px rgba(253, 224, 71, 0.5);
}
.step-divider {
  flex: 1;
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
  margin: 0 0.5rem;
}

/* Header */
.order-page-title {
  font-size: 1.45rem;
  font-weight: 900;
  letter-spacing: -0.02em;
  margin: 0 0 0.35rem 0;
  color: #ffffff;
}
.order-page-desc {
  font-size: 0.85rem;
  color: #94a3b8;
  margin: 0 0 1.4rem 0;
}

/* Bento Order Summary Card */
.order-card {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--gold-border);
  border-radius: 18px;
  padding: 1.35rem;
  margin-bottom: 1.15rem;
  box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.7), 0 0 25px rgba(234, 179, 8, 0.05);
  backdrop-filter: blur(16px);
  position: relative;
  overflow: hidden;
}
.order-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2.5px;
  background: var(--gold-gradient);
}

/* Plan Hero Row */
.plan-hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  margin-bottom: 1rem;
  gap: 0.75rem;
}
.plan-hero-left {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.plan-hero-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(253, 224, 71, 0.2), rgba(217, 119, 6, 0.15));
  border: 1px solid rgba(253, 224, 71, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fde047;
  font-size: 1.25rem;
  box-shadow: 0 0 15px rgba(253, 224, 71, 0.2);
}
.plan-hero-name {
  font-size: 1.05rem;
  font-weight: 900;
  color: #ffffff;
}
.plan-hero-sub {
  font-size: 0.76rem;
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 0.35rem;
  margin-top: 0.15rem;
}
.plan-hero-badge {
  background: rgba(253, 224, 71, 0.12);
  border: 1px solid rgba(253, 224, 71, 0.35);
  color: #fde047;
  font-size: 0.74rem;
  font-weight: 800;
  padding: 0.25rem 0.65rem;
  border-radius: 8px;
  white-space: nowrap;
}

/* Table Breakdown Rows */
.order-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem 0;
  font-size: 0.85rem;
  color: #cbd5e1;
}
.order-detail-row .row-label {
  color: #94a3b8;
}
.order-detail-row .row-val {
  font-weight: 700;
  color: #f1f5f9;
}

/* Badges */
.fee-badge-gold {
  background: rgba(245, 158, 11, 0.15);
  border: 1px solid rgba(245, 158, 11, 0.3);
  color: #fbbf24;
  font-size: 0.76rem;
  font-weight: 800;
  padding: 0.15rem 0.45rem;
  border-radius: 6px;
}
.fee-badge-green {
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.3);
  color: #34d399;
  font-size: 0.76rem;
  font-weight: 800;
  padding: 0.15rem 0.45rem;
  border-radius: 6px;
}

/* WA Alternative Mini Box */
.wa-alt-card {
  margin: 0.75rem 0;
  padding: 0.7rem 0.85rem;
  background: linear-gradient(135deg, rgba(37, 211, 102, 0.08) 0%, rgba(18, 140, 126, 0.03) 100%);
  border: 1px dashed rgba(37, 211, 102, 0.35);
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.65rem;
  flex-wrap: wrap;
}
.wa-alt-text {
  font-size: 0.75rem;
  color: #cbd5e1;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  flex: 1;
  min-width: 170px;
}
.wa-alt-text i {
  color: #25d366;
  font-size: 0.95rem;
}
.wa-alt-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  background: #25d366;
  color: #030712;
  font-weight: 800;
  font-size: 0.72rem;
  padding: 0.35rem 0.7rem;
  border-radius: 7px;
  text-decoration: none;
  white-space: nowrap;
  transition: all 0.2s;
}
.wa-alt-btn:hover {
  background: #22c55e;
  transform: translateY(-1px);
}

/* Total Price Display */
.order-total-box {
  margin-top: 0.9rem;
  padding-top: 0.9rem;
  border-top: 1px dashed rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.order-total-label {
  font-size: 0.9rem;
  font-weight: 800;
  color: #ffffff;
}
.order-total-price {
  font-size: 1.45rem;
  font-weight: 900;
  color: #fde047;
  letter-spacing: -0.02em;
  text-shadow: 0 0 15px rgba(253, 224, 71, 0.25);
}

/* Discount Row */
.discount-row-box {
  background: rgba(253, 224, 71, 0.08);
  border: 1px solid rgba(253, 224, 71, 0.25);
  border-radius: 8px;
  padding: 0.45rem 0.75rem;
  margin-top: 0.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8rem;
  color: #fde047;
  font-weight: 800;
}

/* Promo Card */
.promo-box {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(234, 179, 8, 0.15);
  border-radius: 14px;
  padding: 0.85rem 1rem;
  margin-bottom: 1.15rem;
  backdrop-filter: blur(12px);
}
.promo-box-title {
  font-size: 0.78rem;
  font-weight: 800;
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-bottom: 0.55rem;
}
.promo-input-group {
  display: flex;
  gap: 0.5rem;
}
.promo-input {
  flex: 1;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 9px;
  padding: 0.55rem 0.85rem;
  color: #f8fafc;
  font-size: 0.84rem;
  font-weight: 800;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  outline: none;
  transition: all 0.2s;
}
.promo-input:focus {
  border-color: #fde047;
  box-shadow: 0 0 0 2px rgba(253, 224, 71, 0.2);
}
.promo-btn {
  background: rgba(253, 224, 71, 0.12);
  border: 1px solid rgba(253, 224, 71, 0.35);
  color: #fde047;
  font-size: 0.8rem;
  font-weight: 800;
  padding: 0 1rem;
  border-radius: 9px;
  cursor: pointer;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}
.promo-btn:hover {
  background: #fde047;
  color: #070a12;
  box-shadow: 0 0 12px rgba(253, 224, 71, 0.4);
}
.promo-feedback {
  font-size: 0.75rem;
  margin-top: 0.4rem;
  font-weight: 700;
}

/* Info Note */
.order-info-note {
  background: rgba(234, 179, 8, 0.05);
  border: 1px solid rgba(234, 179, 8, 0.18);
  border-radius: 12px;
  padding: 0.75rem 0.9rem;
  margin-bottom: 1.15rem;
  font-size: 0.77rem;
  color: #cbd5e1;
  line-height: 1.45;
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
}
.order-info-note i {
  color: #fde047;
  font-size: 0.9rem;
  margin-top: 0.1rem;
  flex-shrink: 0;
}

/* Primary Checkout Button (Electric Yellow / Gold) */
.btn-checkout-primary {
  width: 100%;
  height: 48px;
  background: var(--gold-gradient);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  color: #070a12;
  font-size: 0.94rem;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  cursor: pointer;
  box-shadow: var(--gold-glow);
  transition: all 0.2s ease;
  text-shadow: none;
}
.btn-checkout-primary:hover {
  background: linear-gradient(135deg, #fef08a 0%, #facc15 50%, #eab308 100%);
  transform: translateY(-2px);
  box-shadow: 0 6px 25px rgba(234, 179, 8, 0.5);
}
.btn-checkout-primary:active {
  transform: translateY(0);
}

/* Wallet Card */
.wallet-box {
  background: linear-gradient(135deg, rgba(234, 179, 8, 0.08) 0%, rgba(15, 23, 42, 0.8) 100%);
  border: 1px solid rgba(234, 179, 8, 0.25);
  border-radius: 14px;
  padding: 0.95rem 1rem;
  margin-bottom: 1.15rem;
}
.wallet-box-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.55rem;
}
.wallet-title {
  font-size: 0.85rem;
  font-weight: 800;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.wallet-bal-val {
  font-size: 0.88rem;
  font-weight: 900;
  color: #fde047;
}
.wallet-note {
  font-size: 0.76rem;
  color: #94a3b8;
  margin-bottom: 0.75rem;
  line-height: 1.4;
}
.btn-wallet-pay {
  width: 100%;
  height: 44px;
  background: rgba(253, 224, 71, 0.15);
  border: 1px solid rgba(253, 224, 71, 0.4);
  border-radius: 10px;
  color: #fde047;
  font-size: 0.86rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-wallet-pay:hover {
  background: #fde047;
  color: #070a12;
  box-shadow: 0 4px 16px rgba(253, 224, 71, 0.35);
}

/* Security Trust Badges */
.trust-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.15rem;
  margin-top: 1.4rem;
  font-size: 0.74rem;
  color: #64748b;
  flex-wrap: wrap;
}
.trust-item {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}
.trust-item i {
  color: #fde047;
}

@media (max-width: 480px) {
  .order-wrapper { padding: 5.5rem 0.85rem 3rem; }
  .order-card { padding: 1.1rem; }
  .order-page-title { font-size: 1.3rem; }
  .order-total-price { font-size: 1.25rem; }
  .btn-checkout-primary { height: 46px; font-size: 0.9rem; }
}
</style>

<div class="order-wrapper">
  <div class="order-container">
    
    <!-- Breadcrumb / Back -->
    <a href="/pricing" class="order-back-link">
      <i class="fas fa-arrow-left"></i> Pilihan Paket
    </a>

    <!-- Checkout Progress Stepper -->
    <div class="checkout-stepper">
      <div class="step-item active">
        <div class="step-num">1</div>
        <span>Konfirmasi</span>
      </div>
      <div class="step-divider"></div>
      <div class="step-item">
        <div class="step-num">2</div>
        <span>Pembayaran</span>
      </div>
      <div class="step-divider"></div>
      <div class="step-item">
        <div class="step-num">3</div>
        <span>Mulai Main</span>
      </div>
    </div>

    <!-- Title -->
    <h1 class="order-page-title">Konfirmasi Pesanan</h1>
    <p class="order-page-desc">Periksa rincian pesanan sebelum melanjutkan ke pembayaran otomatis.</p>

    <!-- Bento Order Card -->
    <div class="order-card">
      
      <!-- Plan Hero Row -->
      <div class="plan-hero-row">
        <div class="plan-hero-left">
          <div class="plan-hero-icon">
            <i class="fas fa-gamepad"></i>
          </div>
          <div>
            <div class="plan-hero-name"><%= plan.name %></div>
            <div class="plan-hero-sub">
              <i class="fas fa-bolt" style="color:#fde047;"></i> Cloud Gaming PC Server
            </div>
          </div>
        </div>
        <div class="plan-hero-badge">
          <%= plan.duration %> Hari Akses
        </div>
      </div>

      <!-- Price Breakdown -->
      <div class="order-detail-row">
        <span class="row-label">Harga Paket</span>
        <span class="row-val"><%= plan.priceDisplay %></span>
      </div>

      <div class="order-detail-row">
        <span class="row-label">Biaya Layanan Gateway</span>
        <span class="row-val">
          <% if (typeof serviceFee !== 'undefined' && serviceFee > 0) { %>
            <span class="fee-badge-gold">+ Rp <%= serviceFee.toLocaleString('id-ID') %></span>
          <% } else { %>
            <span class="fee-badge-green">Gratis (Rp 0)</span>
          <% } %>
        </span>
      </div>

      <!-- WA Manual Discount Helper -->
      <% if (typeof serviceFee !== 'undefined' && serviceFee > 0) { %>
        <%
          let waManualText = 'Halo Admin AlexCloud! 🛒\n\nSaya mau beli paket *' + plan.name + '* secara MANUAL via WhatsApp agar TANPA BIAYA LAYANAN (Cukup bayar pas ' + plan.priceDisplay + ').\n\n👤 Nama: ' + user.name + '\n📧 Email: ' + user.email + '\n\nMohon dibantu ya min. Terima kasih!';
          let waManualUrl = 'https://wa.me/6285810073341?text=' + encodeURIComponent(waManualText);
        %>
        <div class="wa-alt-card">
          <div class="wa-alt-text">
            <i class="fab fa-whatsapp"></i>
            <span>Bebas biaya admin? Cukup bayar <strong><%= plan.priceDisplay %></strong> via WA:</span>
          </div>
          <a href="<%= waManualUrl %>" target="_blank" rel="noopener" class="wa-alt-btn">
            <i class="fab fa-whatsapp"></i> Order Manual
          </a>
        </div>
      <% } %>

      <div class="order-detail-row" style="border-top: 1px solid rgba(255,255,255,0.06); margin-top:0.35rem; padding-top:0.55rem;">
        <span class="row-label">Akun Pembeli</span>
        <span class="row-val" style="font-size:0.8rem; color:#94a3b8;"><%= user.email %></span>
      </div>

      <!-- Discount Row (Visible only if Promo Applied) -->
      <div id="discountRow" style="display:none;" class="discount-row-box">
        <span><i class="fas fa-tag"></i> Diskon Promo Hemat</span>
        <span id="discountDisplay">- Rp 0</span>
      </div>

      <!-- Total Row -->
      <div class="order-total-box">
        <div class="order-total-label">Total Pembayaran</div>
        <div id="totalDisplay" class="order-total-price">
          <%= typeof initialTotalDisplay !== 'undefined' ? initialTotalDisplay : plan.priceDisplay %>
        </div>
      </div>

    </div>

    <!-- Promo Code Input Card -->
    <div class="promo-box">
      <div class="promo-box-title">
        <i class="fas fa-ticket-alt" style="color:#fde047;"></i> Punya Kode Promo / Voucher? (Opsional)
      </div>
      <div class="promo-input-group">
        <input type="text" id="promoInput" class="promo-input" placeholder="KODE PROMO..." maxlength="30" oninput="this.value = this.value.toUpperCase()">
        <button type="button" class="promo-btn" onclick="applyPromo()">
          <i class="fas fa-check"></i> Pakai
        </button>
      </div>
      <div id="promoStatus" class="promo-feedback"></div>
    </div>

    <!-- Info Note -->
    <div class="order-info-note">
      <i class="fas fa-shield-alt"></i>
      <div>Metode pembayaran lengkap di langkah berikutnya: <strong>QRIS Instan</strong>, <strong>DANA</strong>, <strong>GoPay</strong>, <strong>OVO</strong>, <strong>ShopeePay</strong>, dan <strong>Virtual Account Bank</strong>. Otomatis &amp; 24 jam.</div>
    </div>

    <!-- Saldo / Wallet Payment (If balance > 0) -->
    <% var walletBal = (typeof balance !== 'undefined' && balance) ? balance : 0; %>
    <% if (walletBal > 0) { %>
    <div class="wallet-box" id="walletPayCard">
      <div class="wallet-box-header">
        <div class="wallet-title">
          <i class="fas fa-wallet" style="color:#fde047;"></i> Saldo Dompet AlexCloud
        </div>
        <div class="wallet-bal-val">Rp <%= walletBal.toLocaleString('id-ID') %></div>
      </div>
      <div class="wallet-note" id="walletPayNote"></div>
      <form action="/wallet/pay-plan" method="POST" id="walletForm">
        <input type="hidden" name="planId" value="<%= plan.id %>">
        <input type="hidden" name="customDays" value="<%= plan.id === 'custom_royal' ? plan.duration : '' %>">
        <input type="hidden" name="promoCode" id="wPromoCode" value="">
        <input type="hidden" name="promoId" id="wPromoId" value="">
        <button type="submit" class="btn-wallet-pay" id="walletPayBtn">
          <i class="fas fa-bolt"></i> Bayar Pakai Saldo
        </button>
      </form>
      <div style="text-align:center; margin:0.75rem 0 0.25rem; color:#64748b; font-size:0.74rem; font-weight:800;">— ATAU BAYAR GATEWAY —</div>
    </div>
    <% } %>

    <!-- Main Checkout Form -->
    <form action="/order" method="POST" id="orderForm">
      <input type="hidden" name="planId" value="<%= plan.id %>">
      <input type="hidden" name="customDays" value="<%= plan.id === 'custom_royal' ? plan.duration : '' %>">
      <input type="hidden" name="promoCode" id="hiddenPromoCode" value="">
      <input type="hidden" name="promoId" id="hiddenPromoId" value="">
      <input type="hidden" name="finalPrice" id="hiddenFinalPrice" value="<%= typeof initialTotal !== 'undefined' ? initialTotal : plan.price %>">
      <input type="hidden" name="paymentMethod" value="auto">
      
      <button type="submit" class="btn-checkout-primary">
        <i class="fas fa-arrow-right"></i> Lanjut ke Pembayaran
      </button>
    </form>

    <!-- Trust Badges -->
    <div class="trust-footer">
      <div class="trust-item"><i class="fas fa-lock"></i> Enkripsi 256-Bit SSL</div>
      <div class="trust-item"><i class="fas fa-check-circle"></i> Garansi Full Masa Sewa</div>
      <div class="trust-item"><i class="fas fa-headset"></i> Support CS 24/7</div>
    </div>

  </div>
</div>

<!-- Fullscreen Glassmorphism Loading Overlay -->
<div id="paymentLoadingOverlay" class="loading-overlay" style="display: none;">
  <div class="loading-content">
    <div class="loading-spinner-wrap">
      <div class="loading-spinner"></div>
      <div class="loading-spinner-inner"></div>
      <div class="loading-logo"><img src="/images/logo-icon.png" alt="AlexCloud Logo" width="28" height="28" style="object-fit: contain;"></div>
    </div>
    <h3 class="loading-title">Memproses Pesanan</h3>
    <p class="loading-subtitle">Menyiapkan invoice pembayaran instan...</p>
    <div class="loading-progress-track">
      <div class="loading-progress-bar" id="loadingProgressBar"></div>
    </div>
    <p class="loading-tip">Mohon jangan menutup halaman ini.</p>
  </div>
</div>

<style>
.loading-overlay {
  position: fixed;
  inset: 0;
  background: rgba(7, 10, 18, 0.94);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  z-index: 999999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.loading-overlay.active { opacity: 1; }
.loading-content { text-align: center; max-width: 360px; width: 90%; padding: 2rem; }
.loading-spinner-wrap { position: relative; width: 80px; height: 80px; margin: 0 auto 1.25rem; }
.loading-spinner {
  position: absolute; inset: 0;
  border: 3px solid rgba(255, 255, 255, 0.08);
  border-top-color: #fde047;
  border-radius: 50%;
  animation: spinnerRotate 1.1s cubic-bezier(0.5, 0, 0.5, 1) infinite;
}
.loading-spinner-inner {
  position: absolute; inset: 10px;
  border: 3px solid rgba(234, 179, 8, 0.1);
  border-bottom-color: #d97706;
  border-radius: 50%;
  animation: spinnerRotateReverse 1.4s cubic-bezier(0.5, 0, 0.5, 1) infinite;
}
.loading-logo { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.loading-title { font-size: 1.25rem; font-weight: 800; color: #ffffff; margin-bottom: 0.35rem; }
.loading-subtitle { font-size: 0.82rem; color: #94a3b8; margin-bottom: 1.25rem; }
.loading-progress-track { width: 100%; height: 4px; background: rgba(255, 255, 255, 0.08); border-radius: 10px; overflow: hidden; margin-bottom: 0.85rem; }
.loading-progress-bar { width: 0%; height: 100%; background: var(--gold-gradient); border-radius: 10px; transition: width 0.3s ease; }
.loading-tip { font-size: 0.74rem; color: #64748b; }

@keyframes spinnerRotate { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
@keyframes spinnerRotateReverse { 0% { transform: rotate(360deg); } 100% { transform: rotate(0deg); } }
</style>

<script>
const planPrice = <%= plan.price %>;
const serviceFee = <%= typeof serviceFee !== 'undefined' ? serviceFee : 0 %>;
const initialTotal = <%= typeof initialTotal !== 'undefined' ? initialTotal : plan.price %>;
const planId = '<%= plan.id %>';
const userBalance = <%= walletBal %>;
let appliedPromoId = '';
let appliedPromoCode = '';

function updateWalletNote(finalPrice) {
  var card = document.getElementById('walletPayCard');
  if (!card) return;
  var note = document.getElementById('walletPayNote');
  var btn = document.getElementById('walletPayBtn');
  if (userBalance >= finalPrice) {
    note.innerHTML = '<span style="color:#fde047;"><i class="fas fa-check-circle"></i> Saldo kamu cukup</span> — akun akan langsung aktif otomatis.';
    btn.innerHTML = '<i class="fas fa-bolt"></i> Bayar dengan Saldo (Aktif Instan)';
  } else {
    var sisa = finalPrice - userBalance;
    note.innerHTML = 'Saldo <strong>Rp ' + userBalance.toLocaleString('id-ID') + '</strong> akan dipotong, sisa <strong>Rp ' + sisa.toLocaleString('id-ID') + '</strong> dibayar via QRIS di halaman berikutnya.';
    btn.innerHTML = '<i class="fas fa-wallet"></i> Pakai Saldo + Bayar Sisa';
  }
}
document.addEventListener('DOMContentLoaded', function () { updateWalletNote(initialTotal); });

async function applyPromo() {
  const code = document.getElementById('promoInput').value.trim();
  const status = document.getElementById('promoStatus');
  if (!code) {
    status.innerHTML = '<span style="color:#ef4444;"><i class="fas fa-times-circle"></i> Masukkan kode promo terlebih dahulu.</span>';
    return;
  }
  status.innerHTML = '<span style="color:#94a3b8;"><i class="fas fa-spinner fa-spin"></i> Memeriksa...</span>';
  try {
    const metaToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
    const resp = await fetch('/api/promo/validate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': metaToken },
      body: JSON.stringify({ code, planId })
    });
    const data = await resp.json();
    if (data.valid) {
      status.innerHTML = `<span style="color:#fde047;"><i class="fas fa-check-circle"></i> ${data.message}</span>`;
      document.getElementById('totalDisplay').textContent = data.finalPriceDisplay;
      document.getElementById('discountRow').style.display = 'flex';
      document.getElementById('discountDisplay').textContent = '- Rp ' + data.discount.toLocaleString('id-ID');
      document.getElementById('hiddenPromoCode').value = code;
      document.getElementById('hiddenPromoId').value = data.promoId;
      document.getElementById('hiddenFinalPrice').value = data.finalPrice;
      
      var wc = document.getElementById('wPromoCode'), wi = document.getElementById('wPromoId');
      if (wc) wc.value = code;
      if (wi) wi.value = data.promoId;
      updateWalletNote(data.finalPrice);
      appliedPromoId = data.promoId;
      appliedPromoCode = code;
    } else {
      status.innerHTML = `<span style="color:#ef4444;"><i class="fas fa-times-circle"></i> ${data.message}</span>`;
      resetPromo();
    }
  } catch(e) {
    status.innerHTML = '<span style="color:#ef4444;"><i class="fas fa-exclamation-triangle"></i> Gagal memvalidasi promo.</span>';
  }
}

function resetPromo() {
  document.getElementById('totalDisplay').textContent = '<%= typeof initialTotalDisplay !== 'undefined' ? initialTotalDisplay : plan.priceDisplay %>';
  document.getElementById('discountRow').style.display = 'none';
  document.getElementById('hiddenPromoCode').value = '';
  document.getElementById('hiddenPromoId').value = '';
  document.getElementById('hiddenFinalPrice').value = initialTotal;
  var wc = document.getElementById('wPromoCode'), wi = document.getElementById('wPromoId');
  if (wc) wc.value = '';
  if (wi) wi.value = '';
  updateWalletNote(initialTotal);
  appliedPromoId = '';
  appliedPromoCode = '';
}

document.getElementById('promoInput').addEventListener('keypress', (e) => {
  if (e.key === 'Enter') {
    e.preventDefault();
    applyPromo();
  }
});

function attachLoading(form) {
  if (!form) return;
  form.addEventListener('submit', function(e) {
    const overlay = document.getElementById('paymentLoadingOverlay');
    overlay.style.display = 'flex';
    setTimeout(() => { overlay.classList.add('active'); }, 10);
    
    const progressBar = document.getElementById('loadingProgressBar');
    let progress = 0;
    setInterval(() => {
      if (progress < 90) {
        progress += Math.floor(Math.random() * 8) + 3;
        if (progress > 90) progress = 90;
        progressBar.style.width = progress + '%';
      }
    }, 300);

    const submitBtn = this.querySelector('button[type="submit"]');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.7';
      submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...';
    }
  });
}
attachLoading(document.getElementById('orderForm'));
attachLoading(document.getElementById('walletForm'));
</script>

