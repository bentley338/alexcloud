<%- include('partials/header') %>

<div class="dashboard-page">
  <div class="dashboard-container">
    <div class="dashboard-header">
      <div>
        <p style="color:var(--text-muted); font-family:var(--font-ui); margin-bottom:0.25rem;">Dashboard</p>
        <h1 class="dashboard-greeting" style="display:flex; align-items:center; gap:0.4rem;">
          Halo, <span class="name"><%= user.name.split(' ')[0] %></span>
          <% if (user.isRoyal) { %>
            <i class="fas fa-crown" style="color:#fbbf24; font-size:1.4rem;" title="Royal Club Member"></i>
          <% } %>
          👋
        </h1>
        <!-- Session info badge -->
        <div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.35rem; flex-wrap:wrap;">
          <% if (user.isRoyal) { %>
          <span style="display:inline-flex; align-items:center; gap:0.35rem; background:rgba(251,191,36,0.12); border:1px solid rgba(251,191,36,0.3); color:#fbbf24; font-family:var(--font-ui); font-size:0.75rem; font-weight:700; padding:0.2rem 0.65rem; border-radius:100px; box-shadow: 0 0 10px rgba(251,191,36,0.15);">
            <i class="fas fa-crown"></i> Royal Club Member
          </span>
          <% } %>
          <span style="display:inline-flex; align-items:center; gap:0.35rem; background:rgba(0,255,136,0.08); border:1px solid rgba(0,255,136,0.2); color:var(--accent-green); font-family:var(--font-ui); font-size:0.75rem; font-weight:600; padding:0.2rem 0.6rem; border-radius:100px;">
            <i class="fas fa-shield-halved"></i>
            <% if (user.googleId) { %>
              Login via Google
            <% } else { %>
              Login via Email
            <% } %>
          </span>
          <% if (rememberMe) { %>
          <span style="display:inline-flex; align-items:center; gap:0.35rem; background:rgba(255, 255, 255,0.08); border:1px solid rgba(255, 255, 255,0.2); color:var(--accent-blue); font-family:var(--font-ui); font-size:0.75rem; font-weight:600; padding:0.2rem 0.6rem; border-radius:100px;">
            <i class="fas fa-sync-alt"></i> Sesi tersimpan 30 hari
          </span>
          <% } %>
        </div>
      </div>
      <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap;">
        <% if (user.role === 'admin') { %>
        <a href="/admin?ref_=dash_admin" class="btn-secondary" style="font-family:var(--font-ui)">
          <i class="fas fa-cog"></i> Admin Panel
        </a>
        <% } %>
        <a href="/wallet?ref_=dash_wallet_topup" class="btn-secondary" style="font-family:var(--font-ui)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.3rem;"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a8 8 0 0 1-5.3 7.7 2 2 0 0 1-2.7-1.4l-1-4.2a2 2 0 0 0-1.7-1.5L5 16a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h14"></path><path d="M21 11v4h-3a2 2 0 0 1 0-4h3z"></path></svg> Saldo &amp; Top-up</a>
        <a href="/pricing?ref_=dash_pricing" class="btn-primary"><i class="fas fa-plus"></i> Order Paket</a>
      </div>
    </div>

    <!-- 🎡 FULL-WIDTH LUXURY SPIN THE WHEEL BANNER -->
    <div style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.06) 100%); border: 1.5px solid rgba(245, 158, 11, 0.45); border-radius: 18px; padding: 1.15rem 1.4rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; box-shadow: 0 10px 30px rgba(0,0,0,0.4), 0 0 30px rgba(245,158,11,0.12);">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #f59e0b, #d97706); color: #000; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; box-shadow: 0 4px 18px rgba(245,158,11,0.45); flex-shrink: 0;">
          🎡
        </div>
        <div>
          <div style="font-weight: 900; font-size: 1.1rem; color: #fff; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            <span>Roda Keberuntungan Harian</span>
            <span style="font-size: 0.7rem; background: #00ff88; color: #000; font-weight: 900; padding: 0.15rem 0.55rem; border-radius: 50px; letter-spacing: 0.5px;">GRATIS 1X / 24 JAM</span>
          </div>
          <div style="font-size: 0.82rem; color: #cbd5e1; margin-top: 0.25rem;">
            Putar roda setiap hari untuk kesempatan memenangkan voucher diskon s/d 10%, saldo dompet, &amp; poin gamers!
          </div>
        </div>
      </div>
      <button type="button" onclick="openSpinWheelModal()" style="background: linear-gradient(135deg, #f59e0b, #d97706); color: #000; font-weight: 900; padding: 0.75rem 1.5rem; border-radius: 12px; border: none; cursor: pointer; box-shadow: 0 4px 18px rgba(245,158,11,0.35); font-size: 0.92rem; display: flex; align-items: center; gap: 0.45rem; white-space: nowrap; transition: transform 0.15s ease;">
        <i class="fas fa-play" style="font-size: 0.8rem;"></i> Putar Roda Sekarang
      </button>
    </div>

    <!-- 4 Status Cards (Grid Sempurna) -->
    <div class="dashboard-grid">
      <a href="/wallet?ref_=dash_wallet_card" class="stat-card" style="text-decoration:none; color:inherit; position:relative;">
        <div class="stat-icon green"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a8 8 0 0 1-5.3 7.7 2 2 0 0 1-2.7-1.4l-1-4.2a2 2 0 0 0-1.7-1.5L5 16a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h14"></path><path d="M21 11v4h-3a2 2 0 0 1 0-4h3z"></path></svg></div>
        <div class="stat-info">
          <div class="label">Saldo Dompet</div>
          <div class="value" style="color:var(--accent-green)">Rp <%= (typeof balance !== 'undefined' ? (balance||0) : 0).toLocaleString('id-ID') %></div>
        </div>
        <i class="fas fa-chevron-right" style="position:absolute; top:1rem; right:1rem; font-size:0.75rem; color:var(--text-muted);"></i>
      </a>
      <div class="stat-card">
        <div class="stat-icon blue"><i class="fas fa-box"></i></div>
        <div class="stat-info">
          <div class="label">Total Order</div>
          <div class="value"><%= orders.length %></div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon green"><i class="fas fa-gamepad"></i></div>
        <div class="stat-info">
          <div class="label">Status Akun</div>
          <div class="value" style="font-size:1rem; color:<%= subscription ? 'var(--accent-green)' : '#888' %>">
            <%= subscription ? '✅ Aktif' : '❌ Tidak Aktif' %>
          </div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon purple"><i class="fas fa-calendar"></i></div>
        <div class="stat-info">
          <div class="label">Sisa Hari</div>
          <div class="value"><%= subscription ? subscription.daysLeft + ' hari' : '-' %></div>
        </div>
      </div>
    </div>




<!-- ===================== MODAL CASINO LUCKY WHEEL ===================== -->
<div id="spinModalOverlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.88); backdrop-filter:blur(12px); z-index:999999; align-items:center; justify-content:center; padding:1rem;">
  <div style="background:linear-gradient(180deg, #1e1b4b 0%, #0f172a 100%); border:2px solid #fbbf24; border-radius:28px; max-width:460px; width:100%; text-align:center; padding:2rem 1.5rem 1.75rem; box-shadow:0 25px 70px rgba(0,0,0,0.95), 0 0 50px rgba(251,191,36,0.3); position:relative;">
    
    <button type="button" onclick="closeSpinWheelModal()" style="position:absolute; top:16px; right:18px; background:rgba(255,255,255,0.1); border:none; color:#cbd5e1; font-size:1.35rem; width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer;">×</button>

    <div style="font-weight:900; font-size:1.35rem; color:#fbbf24; letter-spacing:0.5px; text-shadow:0 2px 10px rgba(251,191,36,0.5);">
      🎡 Roda Keberuntungan Harian
    </div>
    <div style="font-size:0.82rem; color:#cbd5e1; margin-top:0.25rem; margin-bottom:1.5rem;">
      Uji keberuntunganmu hari ini dan menangkan hadiah menarik!
    </div>

    <!-- Authentic Casino Lucky Wheel Container -->
    <div style="position:relative; width:310px; height:310px; margin:0 auto 1.5rem; display:flex; align-items:center; justify-content:center;">
      
      <!-- Golden Outer Bezel with Lights -->
      <div style="position:absolute; width:310px; height:310px; border-radius:50%; background:radial-gradient(circle, #f59e0b 0%, #78350f 100%); border:4px solid #fef08a; box-shadow:0 0 30px rgba(245,158,11,0.5), inset 0 0 15px rgba(0,0,0,0.6); z-index:1;"></div>

      <!-- Top Stopper Indicator / Pointer (Triangle with Pin) -->
      <div id="wheelPointer" style="position:absolute; top:-12px; left:50%; transform:translateX(-50%); width:0; height:0; border-left:15px solid transparent; border-right:15px solid transparent; border-top:28px solid #ef4444; z-index:20; filter:drop-shadow(0 4px 6px rgba(0,0,0,0.8)); transition:transform 0.1s ease;"></div>
      
      <!-- Canvas Rotating Disc -->
      <canvas id="wheelCanvas" width="280" height="280" style="border-radius:50%; position:relative; z-index:10; box-shadow:0 0 20px rgba(0,0,0,0.8);"></canvas>
      
      <!-- Center Metallic Golden Cap -->
      <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); width:56px; height:56px; border-radius:50%; background:radial-gradient(circle, #fef08a 0%, #d97706 80%, #78350f 100%); border:3px solid #fff; display:flex; align-items:center; justify-content:center; font-size:1.35rem; color:#000; box-shadow:0 0 15px rgba(0,0,0,0.8); z-index:15;">
        ⚡
      </div>
    </div>

    <!-- Spin Button -->
    <div style="margin-bottom:0.75rem;">
      <button type="button" id="btnDoSpin" onclick="triggerWheelSpin()" style="background:linear-gradient(135deg, #fbbf24 0%, #d97706 100%); color:#000; border:none; font-weight:900; font-size:1.05rem; padding:0.85rem 2.5rem; border-radius:50px; cursor:pointer; box-shadow:0 4px 25px rgba(251,191,36,0.5); letter-spacing:0.5px; transition:transform 0.15s ease;">
        PUTAR RODA SEKARANG!
      </button>
    </div>

    <div id="spinResultFeedback" style="font-size:0.88rem; min-height:24px; color:#cbd5e1; font-weight:700;"></div>

  </div>
</div>

<script>
var wheelCanvas = document.getElementById('wheelCanvas');
var wheelCtx = wheelCanvas ? wheelCanvas.getContext('2d') : null;
var wheelSectors = [
  { label: 'Coba Lagi', icon: '😢', color: '#1e293b', text: '#fff' },
  { label: 'Diskon 5%', icon: '🎟️', color: '#2563eb', text: '#fff' },
  { label: '+10 Poin', icon: '⭐', color: '#7c3aed', text: '#fff' },
  { label: 'Zonk', icon: '🍀', color: '#334155', text: '#fff' },
  { label: 'Diskon 10%', icon: '💎', color: '#ea580c', text: '#fff' },
  { label: 'Saldo 250', icon: '💵', color: '#059669', text: '#fff' },
  { label: '+25 Poin', icon: '🎮', color: '#4f46e5', text: '#fff' },
  { label: 'Saldo 500', icon: '👑', color: '#eab308', text: '#000' }
];
var isWheelSpinning = false;
var countdownTimerInterval = null;

function drawWheel() {
  if (!wheelCtx) return;
  var num = wheelSectors.length;
  var arc = (2 * Math.PI) / num;
  var radius = 140;

  wheelCtx.clearRect(0, 0, 280, 280);

  for (var i = 0; i < num; i++) {
    var angle = i * arc;
    wheelCtx.beginPath();
    wheelCtx.fillStyle = wheelSectors[i].color;
    wheelCtx.moveTo(140, 140);
    wheelCtx.arc(140, 140, radius, angle, angle + arc);
    wheelCtx.lineTo(140, 140);
    wheelCtx.fill();

    // Sector border
    wheelCtx.strokeStyle = 'rgba(255, 255, 255, 0.25)';
    wheelCtx.lineWidth = 2;
    wheelCtx.stroke();

    // Sector text and icon
    wheelCtx.save();
    wheelCtx.translate(140, 140);
    wheelCtx.rotate(angle + arc / 2);
    wheelCtx.textAlign = 'right';
    wheelCtx.fillStyle = wheelSectors[i].text;
    wheelCtx.font = 'bold 11px sans-serif';
    wheelCtx.fillText(wheelSectors[i].icon + ' ' + wheelSectors[i].label, radius - 16, 4);
    wheelCtx.restore();
  }
}

function formatCountdown(totalSec) {
  var h = Math.floor(totalSec / 3600);
  var m = Math.floor((totalSec % 3600) / 60);
  var s = totalSec % 60;
  return (h < 10 ? '0'+h : h) + ':' + (m < 10 ? '0'+m : m) + ':' + (s < 10 ? '0'+s : s);
}

function startCountdown(sec) {
  if (countdownTimerInterval) clearInterval(countdownTimerInterval);
  var currentSec = sec;
  var btn = document.getElementById('btnDoSpin');
  var fb = document.getElementById('spinResultFeedback');

  function update() {
    if (currentSec <= 0) {
      clearInterval(countdownTimerInterval);
      if (btn) {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.style.background = 'linear-gradient(135deg, #fbbf24 0%, #d97706 100%)';
        btn.innerHTML = 'PUTAR RODA SEKARANG!';
      }
      if (fb) fb.innerHTML = '<span style="color:#00ff88;">✅ Kesempatan putar roda hari ini siap!</span>';
      return;
    }

    if (btn) {
      btn.disabled = true;
      btn.style.opacity = '0.7';
      btn.style.background = '#334155';
      btn.innerHTML = '⏳ BUKA DALAM ' + formatCountdown(currentSec);
    }
    if (fb) {
      fb.innerHTML = '<span style="color:#94a3b8;">Kesempatan 1x per hari sudah terpakai. Reset dalam ' + formatCountdown(currentSec) + '</span>';
    }
    currentSec--;
  }

  update();
  countdownTimerInterval = setInterval(update, 1000);
}

async function checkSpinStatus() {
  try {
    var res = await fetch('/api/spin-wheel/status');
    var data = await res.json();
    if (data.success && !data.canSpin) {
      startCountdown(data.remainingSec || 86400);
    } else {
      var btn = document.getElementById('btnDoSpin');
      if (btn) {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.style.background = 'linear-gradient(135deg, #fbbf24 0%, #d97706 100%)';
        btn.innerHTML = 'PUTAR RODA SEKARANG!';
      }
    }
  } catch(e) {}
}

function openSpinWheelModal() {
  var m = document.getElementById('spinModalOverlay');
  if (m) m.style.display = 'flex';
  drawWheel();
  checkSpinStatus();
}

function closeSpinWheelModal() {
  if (isWheelSpinning) return;
  var m = document.getElementById('spinModalOverlay');
  if (m) m.style.display = 'none';
  if (countdownTimerInterval) clearInterval(countdownTimerInterval);
}

async function triggerWheelSpin() {
  if (isWheelSpinning) return;
  var btn = document.getElementById('btnDoSpin');
  var fb = document.getElementById('spinResultFeedback');
  fb.textContent = 'Memutar roda keberuntungan...';
  btn.disabled = true;
  btn.style.opacity = '0.5';

  try {
    var metaToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
    var res = await fetch('/api/spin-wheel', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': metaToken }
    });
    var data = await res.json();

    if (!data.success) {
      fb.innerHTML = '<span style="color:#f87171;">' + (data.message || 'Kesempatan sudah habis.') + '</span>';
      if (data.remainingSec) startCountdown(data.remainingSec);
      return;
    }

    isWheelSpinning = true;

    var targetIndex = data.selectedIndex || 0;
    var num = wheelSectors.length;
    var arcDeg = 360 / num;

    // Center of target slice aligned to top pointer (270 deg / -90 deg)
    var targetDeg = 360 - (targetIndex * arcDeg + arcDeg / 2) - 90;
    var fullSpins = 6 * 360; // 6 full fast spins
    var totalRotation = fullSpins + targetDeg;

    wheelCanvas.style.transition = 'transform 5s cubic-bezier(0.12, 0.95, 0.2, 1)';
    wheelCanvas.style.transform = 'rotate(' + totalRotation + 'deg)';

    setTimeout(function() {
      isWheelSpinning = false;
      fb.innerHTML = '<span style="color:#00ff88; font-size:0.95rem; font-weight:900;">' + data.message + '</span>';
      if (data.voucherCode) {
        fb.innerHTML += '<br><span style="font-size:0.8rem; color:#fbbf24;">Kode Voucher Diskon: <strong>' + data.voucherCode + '</strong> (Tersimpan di akun kamu)</span>';
      }
      startCountdown(24 * 3600);
    }, 5200);

  } catch(e) {
    fb.innerHTML = '<span style="color:#ef4444;">Terjadi kesalahan koneksi.</span>';
    isWheelSpinning = false;
    btn.disabled = false;
    btn.style.opacity = '1';
  }
}
</script>

<%- include('partials/footer') %>