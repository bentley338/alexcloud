<style>
.tab-btn.active {
  background: rgba(37, 211, 102, 0.12) !important;
  border-color: #25d366 !important;
  color: #25d366 !important;
}
</style>

<script>
function switchTab(tab) {
  document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.classList.remove('active');
    btn.style.color = 'var(--text-muted)';
  });
  
  document.getElementById('section-' + tab).style.display = 'block';
  const activeBtn = document.getElementById('tab-btn-' + tab);
  activeBtn.classList.add('active');
  activeBtn.style.color = '#25d366';
}

function toggleWaProvider(provider) {
  document.querySelectorAll('.provider-fields').forEach(el => el.style.display = 'none');
  if (document.getElementById('wa-fields-' + provider)) {
    document.getElementById('wa-fields-' + provider).style.display = 'block';
  }
}

// Live polling for QR code & connection status every 3 seconds
let pollInterval = null;
function startBotPolling() {
  if (pollInterval) clearInterval(pollInterval);
  pollInterval = setInterval(async () => {
    try {
      const res = await fetch('/admin/settings/whatsapp/bot-poll');
      const data = await res.json();
      if (!data) return;

      const badge = document.getElementById('liveStatusBadge');
      const boxConnected = document.getElementById('boxConnected');
      const boxQrReady = document.getElementById('boxQrReady');
      const boxInit = document.getElementById('boxInitializing');
      const userText = document.getElementById('connectedUserText');
      const qrImg = document.getElementById('liveQrImg');

      if (data.status === 'connected') {
        badge.innerHTML = '🟢 Terhubung';
        badge.style.background = 'rgba(16, 185, 129, 0.2)';
        badge.style.color = '#10b981';
        badge.style.borderColor = 'rgba(16, 185, 129, 0.4)';
        boxConnected.style.display = 'block';
        boxQrReady.style.display = 'none';
        boxInit.style.display = 'none';
        if (userText && data.user) userText.innerText = data.user;
      } else if (data.status === 'qr_ready') {
        badge.innerHTML = '🟡 Menunggu Scan';
        badge.style.background = 'rgba(245, 158, 11, 0.2)';
        badge.style.color = '#f59e0b';
        badge.style.borderColor = 'rgba(245, 158, 11, 0.4)';
        boxConnected.style.display = 'none';
        boxQrReady.style.display = 'block';
        boxInit.style.display = 'none';
        if (qrImg && data.qrDataUrl) qrImg.src = data.qrDataUrl;
      } else {
        badge.innerHTML = '🔵 Menyiapkan...';
        boxConnected.style.display = 'none';
        boxQrReady.style.display = 'none';
        boxInit.style.display = 'block';
      }
    } catch(e) {}
  }, 3000);
}

document.addEventListener('DOMContentLoaded', function() {
  const providerSelect = document.getElementById('whatsappProviderSelect');
  if (providerSelect) toggleWaProvider(providerSelect.value);
  startBotPolling();
});
</script>

