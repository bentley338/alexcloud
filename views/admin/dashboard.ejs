<script>
function openModal(id) {
  var m = document.getElementById(id);
  if (m) m.style.display = 'flex';
}
function closeModal(id) {
  var m = document.getElementById(id);
  if (m) m.style.display = 'none';
}
document.querySelectorAll('.admin-modal').forEach(function(m) {
  m.addEventListener('click', function(e) {
    if (e.target === m) m.style.display = 'none';
  });
});

function switchRadarTab(tab) {
  var viewLive = document.getElementById('radarViewLive');
  var viewUsers = document.getElementById('radarViewUsers');
  var viewMap = document.getElementById('radarViewMap');
  var viewTuyul = document.getElementById('radarViewTuyul');

  var btnLive = document.getElementById('tabBtnLive');
  var btnUsers = document.getElementById('tabBtnUsers');
  var btnMap = document.getElementById('tabBtnMap');
  var btnTuyul = document.getElementById('tabBtnTuyul');

  [viewLive, viewUsers, viewMap, viewTuyul].forEach(function(v) { if (v) v.style.display = 'none'; });
  [btnLive, btnUsers, btnMap, btnTuyul].forEach(function(b) { if (b) b.classList.remove('active'); });

  if (tab === 'live') {
    viewLive.style.display = 'block';
    btnLive.classList.add('active');
  } else if (tab === 'users') {
    viewUsers.style.display = 'block';
    btnUsers.classList.add('active');
  } else if (tab === 'map') {
    viewMap.style.display = 'block';
    btnMap.classList.add('active');
    initAdminMapIfNeeded();
  } else if (tab === 'tuyul') {
    viewTuyul.style.display = 'block';
    btnTuyul.classList.add('active');
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// 🔴 SMART VISITOR & USER DETAIL MODAL
// ══════════════════════════════════════════════════════════════════════════════
var globalLiveVisitorsMap = new Map();
var globalUsersCache = [];

function openSmartHistoryModal(id, isUser) {
  var data = null;
  if (isUser) {
    data = globalUsersCache.find(function(u) { return u.id === id; });
  } else {
    data = globalLiveVisitorsMap.get(id);
  }
  if (!data) return;

  document.getElementById('histAvatar').textContent = (data.name || 'U').charAt(0).toUpperCase();
  document.getElementById('histName').textContent = data.name;
  document.getElementById('histEmail').textContent = data.email || 'Pengunjung Tamu (Belum Login)';

  var statusBadge = document.getElementById('histStatusBadge');
  if (data.isOnline) {
    statusBadge.innerHTML = '<span style="color:#00ff88; font-weight:800; font-size:0.75rem; background:rgba(0,255,136,0.15); padding:0.2rem 0.55rem; border-radius:50px;">● ONLINE</span>';
  } else {
    statusBadge.innerHTML = '<span style="color:#94a3b8; font-size:0.75rem; background:rgba(255,255,255,0.06); padding:0.2rem 0.55rem; border-radius:50px;">○ Offline</span>';
  }

  // Render Location History List
  var locContainer = document.getElementById('histLocationList');
  var locList = data.locationHistory || [];
  if (locList.length === 0) {
    locContainer.innerHTML = '<div style="font-size:0.75rem; color:#94a3b8;">' + (data.lastLocation || 'Indonesia 🇮🇩') + ' (IP: ' + (data.lastIp || '-') + ')</div>';
  } else {
    var locHtml = '';
    locList.forEach(function(l) {
      locHtml += '<div style="display:flex; align-items:center; justify-content:space-between; gap:0.4rem; padding:0.35rem 0.5rem; background:rgba(255,255,255,0.02); border-radius:8px;">';
      locHtml += '  <div>';
      locHtml += '    <div style="font-weight:700; font-size:0.78rem; color:#fff;">' + (l.type === 'GPS Akurat 🎯' ? '🎯 ' : '📍 ') + l.location + '</div>';
      locHtml += '    <div style="font-size:0.7rem; color:#94a3b8;">IP: ' + l.ip + (l.isp ? (' • ' + l.isp) : '') + '</div>';
      locHtml += '  </div>';
      if (l.mapsUrl) {
        locHtml += '  <a href="' + l.mapsUrl + '" target="_blank" class="btn-action" style="background:rgba(0,255,136,0.15); color:#00ff88; border:1px solid #00ff88; font-size:0.65rem; padding:0.15rem 0.45rem; border-radius:4px; text-decoration:none; font-weight:800;"><i class="fas fa-map-marked-alt"></i> Peta</a>';
      }
      locHtml += '</div>';
    });
    locContainer.innerHTML = locHtml;
  }

  // Render Page History List
  var pageContainer = document.getElementById('histPageList');
  var pageList = data.pageHistory || [];
  if (pageList.length === 0) {
    pageContainer.textContent = data.lastPage || 'Beranda';
  } else {
    pageContainer.innerHTML = pageList.map(function(p, idx) {
      return (idx === pageList.length - 1) ? ('<strong style="color:#38bdf8;">' + p + '</strong>') : ('<span>' + p + '</span>');
    }).join(' ➔ ');
  }

  // Device and Stats
  document.getElementById('histVisitCount').textContent = (data.visitCount || 1) + 'x Kunjungan';
  document.getElementById('histTotalPages').textContent = (data.totalPagesViewed || 1) + ' Halaman';
  document.getElementById('histDevices').textContent = (data.deviceHistory && data.deviceHistory.length > 0) ? data.deviceHistory.join(', ') : (data.lastDevice || 'Mobile');

  // User Action Controls
  var actionArea = document.getElementById('histUserActionArea');
  if (isUser && data.id) {
    actionArea.style.display = 'block';
    document.getElementById('histTargetUserId').value = data.id;
    var banBtn = document.getElementById('histBanBtn');
    if (data.isBanned) {
      banBtn.value = 'unban';
      banBtn.className = 'btn-action btn-confirm';
      banBtn.innerHTML = '<i class="fas fa-unlock"></i> Buka Blokir';
    } else {
      banBtn.value = 'ban';
      banBtn.className = 'btn-action btn-reject';
      banBtn.innerHTML = '<i class="fas fa-ban"></i> Blokir Akun';
    }
  } else {
    actionArea.style.display = 'none';
  }

  openModal('smartHistoryModal');
}

function formatTimeAgo(timestamp) {
  if (!timestamp) return 'Belum ada data';
  var t = typeof timestamp === 'string' ? new Date(timestamp).getTime() : timestamp;
  var diffSec = Math.floor((Date.now() - t) / 1000);
  if (diffSec < 4) return 'Baru saja ⚡';
  if (diffSec < 60) return diffSec + ' detik lalu';
  var diffMin = Math.floor(diffSec / 60);
  if (diffMin < 60) return diffMin + ' menit lalu';
  var diffHour = Math.floor(diffMin / 60);
  if (diffHour < 24) return diffHour + ' jam lalu';
  var diffDay = Math.floor(diffHour / 24);
  return diffDay + ' hari lalu';
}

async function fetchLiveVisitors() {
  try {
    var res = await fetch('/admin/api/live-visitors');
    if (!res.ok) return;
    var data = await res.json();
    
    // Update Badge Counts
    var countLiveBadge = document.getElementById('countLiveBadge');
    if (countLiveBadge) countLiveBadge.textContent = data.count;
    var countUsersBadge = document.getElementById('countUsersBadge');
    if (countUsersBadge && data.totalRegistered) countUsersBadge.textContent = data.totalRegistered;

    // 1. Render Live Active Tab
    var container = document.getElementById('liveVisitorsContainer');
    if (container) {
      globalLiveVisitorsMap.clear();
      if (!data.visitors || data.visitors.length === 0) {
        container.innerHTML = '<div style="text-align:center; padding:1.5rem; color:#94a3b8; font-size:0.82rem;"><i class="fas fa-moon"></i> Belum ada pengunjung aktif lain saat ini.</div>';
      } else {
        var html = '';
        data.visitors.forEach(function(v) {
          globalLiveVisitorsMap.set(v.id, v);
          var isMe = (v.name === "<%= user.name %>");
          var timeAgo = formatTimeAgo(v.lastSeen);
          var roleBadge = v.role === 'admin' ? '<span style="color:#fbbf24; font-size:0.7rem; font-weight:800; background:rgba(251,191,36,0.15); padding:0.1rem 0.4rem; border-radius:4px;">👑 Admin</span>' : 
                          v.isRoyal ? '<span style="color:#fbbf24; font-size:0.7rem; font-weight:800; background:rgba(251,191,36,0.15); padding:0.1rem 0.4rem; border-radius:4px;">👑 VIP</span>' :
                          v.isUser ? '<span style="color:#00ff88; font-size:0.7rem; font-weight:800; background:rgba(0,255,136,0.15); padding:0.1rem 0.4rem; border-radius:4px;">Member</span>' : 
                          '<span style="color:#94a3b8; font-size:0.7rem; background:rgba(255,255,255,0.06); padding:0.1rem 0.4rem; border-radius:4px;">Tamu</span>';

          var locText = '';
          var mapsBtn = '';

          if (v.gps && v.gps.lat && v.gps.lng) {
            var addr = v.gps.address || (v.gps.lat + ', ' + v.gps.lng);
            locText = '<span style="color:#00ff88; font-weight:800;"><i class="fas fa-crosshairs"></i> GPS Akurat: ' + addr + ' 🎯 🇮🇩</span>';
            var mapsLink = 'https://www.google.com/maps?q=' + v.gps.lat + ',' + v.gps.lng;
            mapsBtn = '<a href="' + mapsLink + '" target="_blank" class="btn-action" style="background:rgba(0,255,136,0.15); color:#00ff88; border:1px solid #00ff88; font-size:0.65rem; padding:0.15rem 0.5rem; border-radius:5px; text-decoration:none; margin-left:0.35rem; font-weight:800;"><i class="fas fa-map-marked-alt"></i> 🗺️ Peta GPS</a>';
          } else {
            var loc = v.location || {};
            var cityName = loc.city ? (loc.city + ', ' + (loc.region || loc.country || 'Indonesia')) : 'Indonesia';
            locText = '<span style="color:#38bdf8; font-weight:700;"><i class="fas fa-map-marker-alt"></i> ' + cityName + ' ' + (loc.flag || '🇮🇩') + '</span>';
            var mapsLink = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(cityName);
            mapsBtn = '<a href="' + mapsLink + '" target="_blank" class="btn-action" style="background:rgba(56,189,248,0.12); color:#38bdf8; border:1px solid rgba(56,189,248,0.3); font-size:0.65rem; padding:0.15rem 0.45rem; border-radius:5px; text-decoration:none; margin-left:0.35rem;"><i class="fas fa-map-marked-alt"></i> 🗺️ Peta</a>';
          }

          var ispText = (v.location && v.location.isp) ? (' • ' + v.location.isp) : '';

          var breadcrumbs = '';
          if (v.pageHistory && v.pageHistory.length > 1) {
            breadcrumbs = '<div style="font-size:0.7rem; color:#64748b; margin-top:0.25rem; display:flex; align-items:center; gap:0.25rem; flex-wrap:wrap;">' +
              '<i class="fas fa-route" style="color:#94a3b8;"></i> Alur: ' +
              v.pageHistory.map(function(p, idx) {
                return (idx === v.pageHistory.length - 1) ? ('<strong style="color:#38bdf8;">' + p + '</strong>') : ('<span>' + p + '</span>');
              }).join(' ➔ ') +
            '</div>';
          }

          html += '<div class="visitor-card ' + (isMe ? 'is-me' : '') + '">';
          html += '  <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:0.65rem; flex-wrap:wrap;">';
          
          html += '    <div style="display:flex; align-items:flex-start; gap:0.65rem; flex:1; min-width:200px;">';
          html += '      <div style="width:34px; height:34px; border-radius:50%; background:' + (v.isUser ? 'linear-gradient(135deg, #00ff88, #00b8d9)' : 'rgba(255,255,255,0.08)') + '; color:#000; font-weight:900; font-size:0.85rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px;">' + (v.name.charAt(0).toUpperCase()) + '</div>';
          html += '      <div style="flex:1;">';
          html += '        <div style="font-weight:800; font-size:0.86rem; color:#fff; display:flex; align-items:center; gap:0.35rem; flex-wrap:wrap;">';
          html += '          <span>' + v.name + (isMe ? ' (Kamu)' : '') + '</span> ' + roleBadge;
          if (v.visitCount > 1) {
            html += '          <span style="font-size:0.68rem; color:#fbbf24; font-weight:800; background:rgba(251,191,36,0.1); padding:0.1rem 0.35rem; border-radius:4px;"><i class="fas fa-redo-alt"></i> ' + v.visitCount + 'x Kunjungan</span>';
          }
          html += '          <button type="button" onclick="openSmartHistoryModal(\'' + v.id + '\', ' + (v.isUser ? 'true' : 'false') + ')" class="btn-action" style="background:rgba(255,255,255,0.08); font-size:0.65rem; padding:0.1rem 0.4rem; border-radius:4px; color:#cbd5e1;"><i class="fas fa-history"></i> Riwayat</button>';
          html += '        </div>';
          if (v.email) {
            html += '        <div style="font-size:0.72rem; color:#94a3b8;">' + v.email + '</div>';
          }
          html += '        <div style="font-size:0.76rem; color:#38bdf8; font-weight:700; margin-top:0.15rem;"><i class="fas fa-eye" style="font-size:0.7rem; margin-right:0.25rem;"></i> Sedang di: <span style="color:#fff;">' + (v.pageTitle || v.currentPage) + '</span></div>';
          html += breadcrumbs;
          html += '      </div>';
          html += '    </div>';

          html += '    <div style="text-align:right; font-size:0.72rem; color:#94a3b8; min-width:140px;">';
          html += '      <div style="display:flex; align-items:center; justify-content:flex-end; gap:0.25rem; flex-wrap:wrap;">' + locText + mapsBtn + '</div>';
          html += '      <div style="color:#cbd5e1; font-size:0.7rem; margin-top:0.1rem;">🌐 IP: <strong style="color:#38bdf8;">' + (v.ip || '-') + '</strong>' + ispText + '</div>';
          html += '      <div style="margin-top:0.15rem;"><i class="fas fa-mobile-alt"></i> ' + (v.device || 'Mobile') + ' • ' + (v.browser || 'Browser') + '</div>';
          html += '      <div style="color:#00ff88; font-weight:700; margin-top:0.2rem;">● ' + timeAgo + ' (' + v.totalPagesViewed + ' Halaman)</div>';
          html += '    </div>';

          html += '  </div>';
          html += '</div>';
        });
        container.innerHTML = html;
      }
    }

    // 2. Render Users Status Tab (Offline & Online Users)
    if (data.usersStatusList) {
      globalUsersCache = data.usersStatusList;
      renderOfflineUsersList(globalUsersCache);
    }

  } catch (e) {}
}

function renderOfflineUsersList(users) {
  var container = document.getElementById('offlineUsersContainer');
  if (!container) return;

  var q = (document.getElementById('offlineUserSearchInput')?.value || '').toLowerCase().trim();
  var filtered = users.filter(function(u) {
    if (!q) return true;
    var str = (u.name + ' ' + u.email + ' ' + (u.phone || '') + ' ' + (u.lastLocation || '') + ' ' + (u.lastIp || '')).toLowerCase();
    return str.indexOf(q) !== -1;
  });

  if (filtered.length === 0) {
    container.innerHTML = '<div style="text-align:center; padding:1.5rem; color:#94a3b8; font-size:0.82rem;">Tidak ada user yang cocok dengan pencarian.</div>';
    return;
  }

  var html = '';
  filtered.forEach(function(u) {
    var isOnline = u.isOnline;
    var statusDot = isOnline ? '<span style="color:#00ff88; font-weight:800; font-size:0.72rem; background:rgba(0,255,136,0.15); padding:0.12rem 0.45rem; border-radius:50px;">● ONLINE</span>' :
                               '<span style="color:#94a3b8; font-size:0.72rem; background:rgba(255,255,255,0.06); padding:0.12rem 0.45rem; border-radius:50px;">○ Offline</span>';
    var lastSeenText = formatTimeAgo(u.lastSeenAt);

    var offlineMapsUrl = (u.lastGps && u.lastGps.lat) ? ('https://www.google.com/maps?q=' + u.lastGps.lat + ',' + u.lastGps.lng) : ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(u.lastLocation || 'Indonesia'));
    var gpsMapsLink = '<a href="' + offlineMapsUrl + '" target="_blank" class="btn-action" style="background:rgba(0,255,136,0.12); color:#00ff88; border:1px solid rgba(0,255,136,0.3); font-size:0.65rem; padding:0.15rem 0.45rem; border-radius:4px; text-decoration:none; margin-left:0.25rem; font-weight:700;"><i class="fas fa-map-marked-alt"></i> 🗺️ Peta</a>';

    html += '<div class="offline-user-card">';
    html += '  <div style="display:flex; align-items:center; gap:0.65rem; flex:1; min-width:200px;">';
    html += '    <div style="width:34px; height:34px; border-radius:50%; background:' + (isOnline ? '#00ff88' : 'rgba(255,255,255,0.08)') + '; color:#000; font-weight:900; font-size:0.85rem; display:flex; align-items:center; justify-content:center; flex-shrink:0;">' + (u.name.charAt(0).toUpperCase()) + '</div>';
    html += '    <div>';
    html += '      <div style="font-weight:800; font-size:0.86rem; color:#fff; display:flex; align-items:center; gap:0.35rem;">';
    html += '        <span>' + u.name + '</span> ' + (u.isRoyal ? '<i class="fas fa-crown" style="color:#fbbf24; font-size:0.75rem;" title="VIP"></i>' : '');
    html += '        ' + statusDot;
    if (u.isBanned) html += '<span class="status-badge status-rejected" style="font-size:0.62rem; padding:0.05rem 0.35rem;">BANNED</span>';
    html += '      </div>';
    html += '      <div style="font-size:0.72rem; color:#94a3b8;">' + u.email + (u.phone ? (' • ' + u.phone) : '') + '</div>';
    html += '      <div style="font-size:0.72rem; color:#38bdf8; margin-top:0.1rem;"><i class="fas fa-history"></i> Terakhir buka: <span style="color:#cbd5e1;">' + (u.lastPage || 'Beranda') + '</span> (' + lastSeenText + ')</div>';
    html += '    </div>';
    html += '  </div>';

    html += '  <div style="display:flex; align-items:center; gap:0.65rem; justify-content:space-between; min-width:170px;">';
    html += '    <div style="text-align:right; font-size:0.72rem; color:#94a3b8;">';
    html += '      <div style="color:#cbd5e1; font-weight:700; display:flex; align-items:center; justify-content:flex-end;"><i class="fas fa-map-marker-alt" style="color:#00ff88; margin-right:0.25rem;"></i> ' + (u.lastLocation || 'Indonesia 🇮🇩') + gpsMapsLink + '</div>';
    html += '      <div style="color:#64748b; font-size:0.68rem; margin-top:0.1rem;">IP: ' + (u.lastIp || '-') + ' • ' + (u.lastDevice || 'Mobile') + '</div>';
    html += '    </div>';
    html += '    <button type="button" onclick="openSmartHistoryModal(\'' + u.id + '\', true)" class="btn-action btn-detail" style="font-size:0.74rem; padding:0.35rem 0.7rem;">';
    html += '      <i class="fas fa-sliders-h"></i> Kelola';
    html += '    </button>';
    html += '  </div>';
    html += '</div>';
  });

  container.innerHTML = html;
}

function filterOfflineUserList() {
  renderOfflineUsersList(globalUsersCache);
}

// Start Polling immediately and interval every 2.5 seconds
fetchLiveVisitors();
setInterval(fetchLiveVisitors, 2500);
</script>

<%- include('layout-footer') %>



<!-- Leaflet CSS & JS for Live Admin Satellite Map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
var adminLeafletMap = null;
var adminMarkersLayer = null;

function initAdminMapIfNeeded() {
  if (adminLeafletMap) {
    adminLeafletMap.invalidateSize();
    return;
  }
  var container = document.getElementById('adminLiveMapContainer');
  if (!container) return;

  adminLeafletMap = L.map('adminLiveMapContainer').setView([-2.5489, 118.0149], 5);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; OpenStreetMap &copy; CARTO',
    maxZoom: 18
  }).addTo(adminLeafletMap);

  adminMarkersLayer = L.layerGroup().addTo(adminLeafletMap);
  updateAdminMapMarkers();
}

function updateAdminMapMarkers() {
  if (!adminLeafletMap || !adminMarkersLayer) return;
  adminMarkersLayer.clearLayers();

  var visitors = Array.from(globalLiveVisitorsMap.values());
  visitors.forEach(function(v) {
    var lat = null, lng = null, isGps = false;
    if (v.gps && v.gps.lat && v.gps.lng) {
      lat = v.gps.lat; lng = v.gps.lng; isGps = true;
    }
    if (lat && lng) {
      var iconHtml = '<div style="width:16px; height:16px; border-radius:50%; background:' + (isGps ? '#00ff88' : '#38bdf8') + '; box-shadow:0 0 12px ' + (isGps ? '#00ff88' : '#38bdf8') + '; border:2px solid #fff;"></div>';
      var customIcon = L.divIcon({ html: iconHtml, className: 'radar-leaflet-pin', iconSize: [16, 16] });
      var marker = L.marker([lat, lng], { icon: customIcon }).addTo(adminMarkersLayer);
      
      var popupContent = 
        '<div style="font-family:sans-serif; color:#000; font-size:12px; min-width:160px;">' +
        '  <strong style="font-size:13px;">' + v.name + '</strong><br>' +
        '  <span>' + (isGps ? '🎯 GPS Presisi' : '📍 Lokasi IP') + '</span><br>' +
        '  <span style="color:#555;">' + (v.gps?.address || v.location?.city || 'Indonesia') + '</span><br>' +
        '  <a href="' + (v.gps?.mapsUrl || '#') + '" target="_blank" style="display:inline-block; margin-top:4px; color:#0066cc; font-weight:bold;">🗺️ Buka Google Maps</a>' +
        '</div>';
      marker.bindPopup(popupContent);
    }
  });
}
</script>
