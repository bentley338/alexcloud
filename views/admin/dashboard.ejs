<% currentPage = 'dashboard'; %>
<%- include('layout-header') %>

<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-bottom:1.15rem;">
  <div>
    <h1 class="admin-page-title" style="margin:0;"><i class="fas fa-tachometer-alt" style="color:var(--admin-gold);"></i> Admin Master Control</h1>
    <div style="font-size:0.8rem; color:#94a3b8; margin-top:0.15rem;">Live radar pengunjung, pelacak GPS akurat, deteksi VPN &amp; riwayat aktivitas user</div>
  </div>
  <div style="display:flex; align-items:center; gap:0.45rem; flex-wrap:wrap;">
    <a href="/admin/backup-db" class="btn-action" style="background:rgba(251,191,36,0.12); color:var(--admin-gold); border:1px solid rgba(251,191,36,0.3); font-size:0.78rem; padding:0.4rem 0.8rem; border-radius:8px;">
      <i class="fas fa-download"></i> Backup DB (.json)
    </a>
  </div>
</div>

<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
  <% success.forEach(s => { %><div class="alert alert-success" style="margin-bottom:1rem; background:rgba(0,255,136,0.1); border:1px solid #00ff88; color:#00ff88; padding:0.75rem 1rem; border-radius:10px;"><i class="fas fa-check-circle"></i> <%= s %></div><% }) %>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <% error.forEach(e => { %><div class="alert alert-error" style="margin-bottom:1rem; background:rgba(255,68,68,0.1); border:1px solid #ff4444; color:#ff4444; padding:0.75rem 1rem; border-radius:10px;"><i class="fas fa-exclamation-circle"></i> <%= e %></div><% }) %>
<% } %>

<!-- 🔴 PUSAT RADAR AKTIVITAS & PELACAK PENGUNJUNG REAL-TIME (ONLINE & OFFLINE) -->
<div class="card" style="margin-bottom:1.25rem; border:1px solid rgba(0, 255, 136, 0.4); box-shadow: 0 0 30px rgba(0, 255, 136, 0.09);">
  <div class="card-header" style="background:linear-gradient(90deg, rgba(0, 255, 136, 0.1) 0%, rgba(17, 19, 31, 0.98) 100%);">
    <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
      <div class="card-title" style="color:#00ff88; font-size:0.95rem; margin-right:0.5rem;">
        <span style="display:inline-block; width:10px; height:10px; border-radius:50%; background:#00ff88; box-shadow:0 0 10px #00ff88; animation:pulse 1.5s infinite;"></span>
        <span>Radar Aktivitas &amp; GPS Pengunjung</span>
      </div>
      <!-- Tab Controls -->
      <div style="display:flex; align-items:center; gap:0.35rem; background:rgba(0,0,0,0.4); padding:0.2rem; border-radius:50px; border:1px solid rgba(255,255,255,0.1);">
        <button type="button" onclick="switchRadarTab('live')" id="tabBtnLive" class="radar-tab-btn active">
          🟢 Live Online (<span id="countLiveBadge">0</span>)
        </button>
        <button type="button" onclick="switchRadarTab('users')" id="tabBtnUsers" class="radar-tab-btn">
          👥 Semua User (<span id="countUsersBadge"><%= clientUsers.length %></span>)
        </button>
        <button type="button" onclick="switchRadarTab('map')" id="tabBtnMap" class="radar-tab-btn">
          🗺️ Live Map Satelit
        </button>
        <button type="button" onclick="switchRadarTab('tuyul')" id="tabBtnTuyul" class="radar-tab-btn" style="color:#ef4444;">
          🚨 Anti-Tuyul (<span id="countTuyulBadge">0</span>)
        </button>
      </div>
    </div>
    <div style="font-size:0.72rem; color:#94a3b8; display:flex; align-items:center; gap:0.35rem;">
      <i class="fas fa-sync-alt fa-spin" style="font-size:0.68rem; color:#00ff88;"></i> Real-Time 2.5s
    </div>
  </div>
  
  <div style="padding:0.85rem;">
    <!-- Live Tab 1: Active Visitors Now -->
    <div id="radarViewLive">
      <div id="liveVisitorsContainer" style="display:flex; flex-direction:column; gap:0.65rem; max-height:380px; overflow-y:auto;">
        <div style="text-align:center; padding:1.75rem; color:#94a3b8; font-size:0.82rem;">
          <i class="fas fa-circle-notch fa-spin"></i> Menghubungkan ke live radar aktivitas pengunjung...
        </div>
      </div>
    </div>

    <!-- Users Tab 2: Registered Users (Online & Offline Tracker) -->
    <div id="radarViewUsers" style="display:none;">
      <div style="margin-bottom:0.75rem;">
        <input type="text" id="offlineUserSearchInput" class="admin-modal-input" placeholder="🔍 Cari user untuk cek lokasi GPS, IP & waktu terakhir masuk..." style="margin-bottom:0.4rem;" oninput="filterOfflineUserList()">
      </div>
      <div id="offlineUsersContainer" style="display:flex; flex-direction:column; gap:0.55rem; max-height:380px; overflow-y:auto;">
        <div style="text-align:center; padding:1.5rem; color:#94a3b8; font-size:0.82rem;">
          <i class="fas fa-spinner fa-spin"></i> Memuat status seluruh user...
        </div>
      </div>
    </div>

    <!-- Map Tab 3: Live Leaflet Interactive Map -->
    <div id="radarViewMap" style="display:none;">
      <div id="adminLiveMapContainer" style="height:360px; width:100%; border-radius:12px; overflow:hidden; border:1px solid rgba(0,255,136,0.3);">
      </div>
    </div>

    <!-- Tuyul Tab 4: Multi-Account Detection -->
    <div id="radarViewTuyul" style="display:none;">
      <div id="multiAccountListContainer" style="display:flex; flex-direction:column; gap:0.65rem; max-height:380px; overflow-y:auto;">
        <div style="text-align:center; padding:1.5rem; color:#94a3b8; font-size:0.82rem;">
          <i class="fas fa-shield-alt" style="color:#00ff88;"></i> Sistem aman! Belum terdeteksi multi-akun atau tuyul aktif.
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes pulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 136, 0.7); }
  70% { transform: scale(1.15); box-shadow: 0 0 0 8px rgba(0, 255, 136, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 136, 0); }
}
.radar-tab-btn {
  background: transparent;
  border: none;
  color: #94a3b8;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.25rem 0.65rem;
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.2s ease;
}
.radar-tab-btn.active {
  background: #00ff88;
  color: #000;
  font-weight: 900;
  box-shadow: 0 2px 8px rgba(0, 255, 136, 0.4);
}
.visitor-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--admin-border);
  border-radius: 12px;
  padding: 0.75rem 0.95rem;
  transition: all 0.2s ease;
}
.visitor-card.is-me {
  border-color: rgba(251, 191, 36, 0.4);
  background: rgba(251, 191, 36, 0.04);
}
.visitor-card:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.18);
}
.offline-user-card {
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 12px;
  padding: 0.75rem 0.9rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.65rem;
  flex-wrap: wrap;
  transition: 0.15s;
}
.offline-user-card:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.15);
}
</style>

<!-- ⚡ PUSAT FITUR ADMIN REAL & EKSEKUSI KILAT (QUICK TOOLS) -->
<div class="card" style="margin-bottom:1.25rem; border:1px solid rgba(251, 191, 36, 0.25);">
  <div class="card-header" style="background:rgba(251,191,36,0.04);">
    <div class="card-title" style="color:var(--admin-gold); font-size:0.92rem;"><i class="fas fa-bolt"></i> Menu Eksekusi &amp; Manajemen Cepat (HP Optimized)</div>
  </div>
  <div style="padding:0.85rem; display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:0.55rem;">
    <!-- Top-up User -->
    <button type="button" onclick="openModal('quickWalletModal')" class="btn-action" style="padding:0.75rem 0.5rem; background:rgba(0, 255, 136, 0.08); border:1px solid rgba(0, 255, 136, 0.3); color:#00ff88; border-radius:10px; flex-direction:column; gap:0.3rem; justify-content:center; text-align:center;">
      <i class="fas fa-wallet" style="font-size:1.15rem;"></i>
      <span style="font-size:0.78rem; font-weight:700;">+ Saldo User</span>
    </button>
    <!-- Grant Royal VIP -->
    <button type="button" onclick="openModal('quickRoyalModal')" class="btn-action" style="padding:0.75rem 0.5rem; background:rgba(251, 191, 36, 0.08); border:1px solid rgba(251, 191, 36, 0.3); color:#fbbf24; border-radius:10px; flex-direction:column; gap:0.3rem; justify-content:center; text-align:center;">
      <i class="fas fa-crown" style="font-size:1.15rem;"></i>
      <span style="font-size:0.78rem; font-weight:700;">Beri VIP Royal</span>
    </button>
    <!-- Quick Add Game -->
    <button type="button" onclick="openModal('quickGameModal')" class="btn-action" style="padding:0.75rem 0.5rem; background:rgba(20, 184, 166, 0.08); border:1px solid rgba(20, 184, 166, 0.3); color:#2dd4bf; border-radius:10px; flex-direction:column; gap:0.3rem; justify-content:center; text-align:center;">
      <i class="fas fa-gamepad" style="font-size:1.15rem;"></i>
      <span style="font-size:0.78rem; font-weight:700;">+ Tambah Game</span>
    </button>
    <!-- Quick Promo -->
    <button type="button" onclick="openModal('quickPromoModal')" class="btn-action" style="padding:0.75rem 0.5rem; background:rgba(59, 130, 246, 0.08); border:1px solid rgba(59, 130, 246, 0.3); color:#60a5fa; border-radius:10px; flex-direction:column; gap:0.3rem; justify-content:center; text-align:center;">
      <i class="fas fa-tag" style="font-size:1.15rem;"></i>
      <span style="font-size:0.78rem; font-weight:700;">Buat Promo</span>
    </button>
    <!-- Broadcast Message -->
    <button type="button" onclick="openModal('quickBroadcastModal')" class="btn-action" style="padding:0.75rem 0.5rem; background:rgba(168, 85, 247, 0.08); border:1px solid rgba(168, 85, 247, 0.3); color:#c084fc; border-radius:10px; flex-direction:column; gap:0.3rem; justify-content:center; text-align:center;">
      <i class="fas fa-bullhorn" style="font-size:1.15rem;"></i>
      <span style="font-size:0.78rem; font-weight:700;">Broadcast Web</span>
    </button>
    <!-- WA Bot Automation -->
    <a href="/admin/settings/whatsapp" class="btn-action" style="padding:0.75rem 0.5rem; background:rgba(37, 211, 102, 0.08); border:1px solid rgba(37, 211, 102, 0.3); color:#25d366; border-radius:10px; flex-direction:column; gap:0.3rem; justify-content:center; text-align:center; text-decoration:none;">
      <i class="fab fa-whatsapp" style="font-size:1.15rem;"></i>
      <span style="font-size:0.78rem; font-weight:700;">Setelan WA Bot</span>
    </a>
  </div>
</div>

<!-- 📊 GRID STATISTIK FINANSIAL & PENGGUNA (2 KOLOM HP) -->
<div class="admin-stats-grid">
  <div class="admin-stat-card">
    <div class="admin-stat-value" style="color:var(--accent-blue)"><%= stats.totalUsers %></div>
    <div class="admin-stat-label"><i class="fas fa-users"></i> Total User Terdaftar</div>
  </div>
  <div class="admin-stat-card">
    <div class="admin-stat-value" style="color:#fbbf24"><%= stats.royalMembersCount || 0 %></div>
    <div class="admin-stat-label"><i class="fas fa-crown"></i> Member Royal VIP</div>
  </div>
  <div class="admin-stat-card">
    <div class="admin-stat-value" style="color:var(--accent-green)"><%= stats.activeSubscriptions %></div>
    <div class="admin-stat-label"><i class="fas fa-id-card"></i> Subscription Aktif</div>
  </div>
  <div class="admin-stat-card">
    <div class="admin-stat-value" style="color:#2dd4bf"><%= stats.totalGames %></div>
    <div class="admin-stat-label"><i class="fas fa-gamepad"></i> Game di Library</div>
  </div>
  <div class="admin-stat-card" style="grid-column: span 2; background: linear-gradient(135deg, rgba(244,63,94,0.12) 0%, rgba(17,19,31,0.95) 100%);">
    <div class="admin-stat-value" style="color:#F43F5E;">Rp <%= stats.totalRevenue.toLocaleString('id-ID') %></div>
    <div class="admin-stat-label"><i class="fas fa-money-bill-wave"></i> Total Pendapatan Bersih</div>
  </div>
</div>

<!-- 🖥️ CLOUD GAMING NODE & SYSTEM HEALTH -->
<div class="card" style="margin-bottom:1.25rem;">
  <div class="card-header">
    <div class="card-title"><i class="fas fa-network-wired" style="color:var(--accent-green);"></i> Status Server Node Cloud Gaming &amp; Gateway</div>
  </div>
  <div style="padding:0.85rem; display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:0.65rem;">
    <% serverNodes.forEach(node => { %>
    <div style="background:rgba(255,255,255,0.03); border:1px solid var(--admin-border); border-radius:12px; padding:0.85rem;">
      <div style="display:flex; align-items:center; justify-content:space-between;">
        <span style="font-weight:800; font-size:0.85rem; color:#fff;"><%= node.name %></span>
        <span style="font-size:0.72rem; color:#00ff88; font-weight:800; background:rgba(0,255,136,0.1); padding:0.15rem 0.45rem; border-radius:50px;"><%= node.ping %></span>
      </div>
      <div style="display:flex; align-items:center; justify-content:space-between; margin-top:0.5rem; font-size:0.76rem; color:#94a3b8;">
        <span>Beban Node: <strong style="color:#cbd5e1;"><%= node.load %></strong></span>
        <span>Online Players: <strong style="color:var(--accent-blue);"><%= node.players %></strong></span>
      </div>
    </div>
    <% }); %>
    <div style="background:rgba(255,255,255,0.03); border:1px solid var(--admin-border); border-radius:12px; padding:0.85rem;">
      <div style="display:flex; align-items:center; justify-content:space-between;">
        <span style="font-weight:800; font-size:0.85rem; color:#fff;">⚡ Payment Gateway Engine</span>
        <span style="font-size:0.72rem; color:#00ff88; font-weight:800; background:rgba(0,255,136,0.1); padding:0.15rem 0.45rem; border-radius:50px;">100% ONLINE</span>
      </div>
      <div style="margin-top:0.5rem; font-size:0.76rem; color:#94a3b8;">
        QRIS, VA Bank &amp; E-Wallet Terverifikasi Otomatis
      </div>
    </div>
  </div>
</div>

<!-- Recent Transactions Log -->
<div class="card">
  <div class="card-header">
    <div class="card-title"><i class="fas fa-history"></i> Transaksi Terverifikasi Otomatis</div>
    <a href="/admin/orders" class="btn-action btn-detail">Lihat Semua Data →</a>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Order ID</th>
          <th>User</th>
          <th>Paket / Nominal</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentOrders.length === 0) { %>
        <tr><td colspan="4" style="text-align:center; padding:2rem; color:var(--text-muted);">Belum ada riwayat order.</td></tr>
        <% } %>
        <% recentOrders.forEach(order => { %>
        <tr>
          <td>
            <span style="font-family:var(--font-display); font-size:0.78rem; color:var(--accent-blue); font-weight:800;"><%= order.orderId %></span>
            <div style="font-size:0.7rem; color:#64748b;"><%= moment(order.createdAt).format('DD MMM, HH:mm') %></div>
          </td>
          <td>
            <div style="font-weight:700; font-size:0.85rem;"><%= order.userName %></div>
            <div style="font-size:0.72rem; color:var(--text-muted);"><%= order.userEmail %></div>
          </td>
          <td>
            <div style="font-size:0.82rem; font-weight:600;"><%= order.planName || 'Top-up Saldo' %></div>
            <div style="color:var(--accent-green); font-weight:800; font-size:0.85rem;">Rp <%= (order.price || 0).toLocaleString('id-ID') %></div>
          </td>
          <td>
            <span class="status-badge status-<%= order.status %>">
              <%= order.status === 'confirmed' ? '✅ Otomatis Lunas' : order.status === 'pending' ? '⏳ Menunggu Bayar' : '❌ Batal' %>
            </span>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- ===================== MODALS ===================== -->

<!-- Modal: Smart History & User Detail Master -->
<div class="admin-modal" id="smartHistoryModal">
  <div class="admin-modal-box" style="max-width:540px;">
    <div class="admin-modal-head">
      <div class="admin-modal-title" style="font-size:0.95rem; display:flex; align-items:center; gap:0.45rem;">
        <i class="fas fa-fingerprint" style="color:var(--accent-green);"></i>
        <span>Profil &amp; Riwayat Cerdas Pengunjung</span>
      </div>
      <button class="admin-modal-close" onclick="closeModal('smartHistoryModal')">×</button>
    </div>

    <div style="margin-bottom:0.85rem; padding:0.75rem 0.95rem; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:12px; display:flex; align-items:center; justify-content:space-between; gap:0.5rem; flex-wrap:wrap;">
      <div style="display:flex; align-items:center; gap:0.65rem;">
        <div id="histAvatar" style="width:38px; height:38px; border-radius:50%; background:#00ff88; color:#000; font-weight:900; font-size:1rem; display:flex; align-items:center; justify-content:center;">U</div>
        <div>
          <div style="font-weight:800; font-size:0.92rem; color:#fff;" id="histName">-</div>
          <div style="font-size:0.75rem; color:#94a3b8;" id="histEmail">-</div>
        </div>
      </div>
      <div id="histStatusBadge"></div>
    </div>

    <!-- Smart Sections -->
    <div style="display:flex; flex-direction:column; gap:0.85rem; max-height:420px; overflow-y:auto; padding-right:0.25rem;">
      
      <!-- 1. Riwayat Lokasi & IP -->
      <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(0,255,136,0.25); border-radius:12px; padding:0.85rem;">
        <div style="font-size:0.82rem; font-weight:800; color:#00ff88; margin-bottom:0.55rem; display:flex; align-items:center; gap:0.35rem;">
          <i class="fas fa-map-marked-alt"></i> Riwayat Lokasi &amp; Jaringan IP (Deteksi VPN)
        </div>
        <div id="histLocationList" style="display:flex; flex-direction:column; gap:0.45rem;">
          <!-- Injected via JS -->
        </div>
      </div>

      <!-- 2. Riwayat Alur Halaman (Breadcrumbs) -->
      <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(56,189,248,0.25); border-radius:12px; padding:0.85rem;">
        <div style="font-size:0.82rem; font-weight:800; color:#38bdf8; margin-bottom:0.55rem; display:flex; align-items:center; gap:0.35rem;">
          <i class="fas fa-route"></i> Alur Jejak Halaman yang Dibuka
        </div>
        <div id="histPageList" style="font-size:0.75rem; color:#cbd5e1; line-height:1.6;">
          <!-- Injected via JS -->
        </div>
      </div>

      <!-- 3. Perangkat & Statistik Sesi -->
      <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(251,191,36,0.25); border-radius:12px; padding:0.85rem;">
        <div style="font-size:0.82rem; font-weight:800; color:#fbbf24; margin-bottom:0.55rem; display:flex; align-items:center; gap:0.35rem;">
          <i class="fas fa-laptop-mobile"></i> Perangkat &amp; Statistik Kunjungan
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.45rem; font-size:0.75rem; color:#94a3b8;">
          <div>Total Kunjungan: <strong id="histVisitCount" style="color:#fff;">1x</strong></div>
          <div>Total Halaman: <strong id="histTotalPages" style="color:#fff;">1</strong></div>
          <div style="grid-column:span 2;">Perangkat: <strong id="histDevices" style="color:#cbd5e1;">-</strong></div>
        </div>
      </div>

      <!-- 4. Aksi Kilat Admin (Jika user terdaftar) -->
      <div id="histUserActionArea" style="display:none; padding-top:0.4rem;">
        <form action="/admin/quick-user-action" method="POST">
          <input type="hidden" name="userId" id="histTargetUserId">
          <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
            <button type="submit" name="action" value="reset_pw" class="btn-action btn-detail" style="flex:1; padding:0.6rem; justify-content:center; font-size:0.78rem;">
              <i class="fas fa-key"></i> Reset Password
            </button>
            <button type="submit" name="action" id="histBanBtn" value="ban" class="btn-action btn-reject" style="flex:1; padding:0.6rem; justify-content:center; font-size:0.78rem;">
              <i class="fas fa-ban"></i> Blokir Akun
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>

<!-- Modal: Quick Add Game -->
<div class="admin-modal" id="quickGameModal">
  <div class="admin-modal-box">
    <div class="admin-modal-head">
      <div class="admin-modal-title"><i class="fas fa-gamepad" style="color:#2dd4bf;"></i> Tambah Game ke Cloud Library</div>
      <button class="admin-modal-close" onclick="closeModal('quickGameModal')">×</button>
    </div>
    <form action="/admin/quick-add-game" method="POST">
      <label style="font-size:0.8rem; color:#94a3b8; margin-bottom:0.25rem; display:block;">Judul Game:</label>
      <input type="text" name="title" class="admin-modal-input" placeholder="contoh: Grand Theft Auto V / Cyberpunk 2077" required>
      
      <label style="font-size:0.8rem; color:#94a3b8; margin-bottom:0.25rem; display:block;">Genre Game:</label>
      <input type="text" name="genre" class="admin-modal-input" placeholder="contoh: Open World / RPG / FPS" value="Action / Adventure">

      <label style="font-size:0.8rem; color:#94a3b8; margin-bottom:0.25rem; display:block;">URL Gambar Cover (Poster):</label>
      <input type="text" name="image" class="admin-modal-input" placeholder="contoh: https://... / /images/games/gta5.jpg" required>

      <label style="font-size:0.8rem; color:#94a3b8; margin-bottom:0.25rem; display:block;">Kategori Tampilan:</label>
      <select name="category" class="admin-modal-input" style="background:#1a1d2e;">
        <option value="featured">🔥 Featured &amp; Populer</option>
        <option value="action">⚔️ Action &amp; Adventure</option>
